echo "=== workflow YAML validation ==="
python -c "import yaml; [print(f, \"OK\") for f in [\".github/workflows/ci.yml\",\".github/workflows/deploy.yml\"] if yaml.safe_load(open(f, encoding=\"utf-8\")) is not None]"
