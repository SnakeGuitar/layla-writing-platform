<Page x:Class="Layla.Desktop.Views.Manuscripts.ManuscriptEditorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="ManuscriptEditorView"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Chapter navigation sidebar -->
            <ColumnDefinition Width="230" MinWidth="180" MaxWidth="350"/>
            <ColumnDefinition Width="2"/>
            <!-- Editor area -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2"/>
            <!-- Context panel (wiki entities in current chapter) -->
            <ColumnDefinition Width="250" MinWidth="200" MaxWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT SIDEBAR: Manuscripts + Chapters ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource NmSurfaceBrush}"
                BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Manuscript Selector -->
                <Border Grid.Row="0" Padding="15,15,15,10" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="MANUSCRITOS" Style="{StaticResource NmLabelText}" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource NmAccentBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ManuscriptComboBox"
                                      Grid.Column="0"
                                      ItemsSource="{Binding Manuscripts}"
                                      SelectedItem="{Binding SelectedManuscript}"
                                      DisplayMemberPath="Title"
                                      SelectionChanged="ManuscriptComboBox_SelectionChanged"/>
                            <Button x:Name="AddManuscriptButton" Grid.Column="1" Content="+" ToolTip="Agregar manuscrito"
                                    Width="30" Height="30" Margin="6,0,0,0"
                                    Style="{StaticResource NmButtonPrimary}" Padding="0" FontSize="14" FontWeight="Bold" Cursor="Hand"
                                    Click="AddManuscriptButton_Click"/>
                            <Button Grid.Column="2" x:Name="DeleteManuscriptButton"
                                    ToolTip="Eliminar manuscrito actual"
                                    Width="30" Height="30" Margin="6,0,0,0"
                                    Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmErrorBrush}" Padding="0" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                    Content="🗑"
                                    Click="DeleteManuscriptButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Chapter List Header -->
                <Border Grid.Row="1" Padding="15,12,15,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CAPÍTULOS" Style="{StaticResource NmLabelText}" FontWeight="Bold" Foreground="{DynamicResource NmAccentBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="AddChapterButton" Grid.Column="1" Content="+ Añadir" ToolTip="Añadir capítulo"
                                Style="{StaticResource NmButtonGhost}" Padding="6,2" FontSize="11" FontWeight="SemiBold"
                                Click="AddChapterButton_Click"/>
                    </Grid>
                </Border>

                <!-- Chapter List -->
                <ListBox Grid.Row="2" x:Name="ChapterListBox"
                         ItemsSource="{Binding CurrentChapters}"
                         SelectedItem="{Binding SelectedChapterItem}"
                         Background="Transparent" BorderThickness="0"
                         Padding="10,0"
                         SelectionChanged="ChapterListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5"
                                           Foreground="{DynamicResource NmTextPrimaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Padding="6,6"/>
                                <Button Grid.Column="1" Content="🗑" FontSize="11" Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmErrorBrush}"
                                        BorderThickness="0" Cursor="Hand" Padding="4,2"
                                        VerticalAlignment="Center" ToolTip="Eliminar capítulo"
                                        Tag="{Binding}"
                                        Visibility="{Binding IsEditablePage, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                        Click="DeleteChapterButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NmShadowLightBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NmShadowLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch"
                      Background="{DynamicResource NmShadowDarkBrush}" Cursor="SizeWE"/>

        <!-- ═══ CENTER: Editor Area ═══ -->
        <Grid Grid.Column="2" Margin="10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Padding="15,12" Background="Transparent" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Editor de Manuscrito" Style="{StaticResource NmTitleText}" FontSize="18" Foreground="{DynamicResource NmAccentBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="SaveButton" Content="💾 Guardar"
                            ToolTip="Guardar capítulo actual (Ctrl+S)"
                            Style="{StaticResource NmButtonPrimary}" Padding="16,6"
                            Cursor="Hand" Click="SaveButton_Click"/>
                </Grid>
            </Border>

            <!-- ═══ TOOLBAR ═══ -->
            <Border Grid.Row="1" Margin="10,12,10,0" Padding="8" CornerRadius="10" Background="{DynamicResource NmSurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="2" Direction="315" BlurRadius="4" Opacity="0.5"/>
                </Border.Effect>
                
                <ToolBarTray Background="Transparent" IsLocked="True">
                    <!-- Row 1: Font settings -->
                    <ToolBar Background="Transparent" Band="0" BandIndex="0">
                        <ComboBox x:Name="FontFamilyComboBox" Width="140" FontSize="12"
                                  SelectionChanged="FontFamilyComboBox_SelectionChanged" ToolTip="Familia de fuente"/>
                        <ComboBox x:Name="FontSizeComboBox" Width="55" FontSize="12" IsEditable="True" Margin="6,0,0,0"
                                  SelectionChanged="FontSizeComboBox_SelectionChanged" KeyDown="FontSizeComboBox_KeyDown" ToolTip="Tamaño de fuente"/>
                        <Separator Margin="8,0"/>
                        <Button x:Name="FontColorButton" ToolTip="Color de fuente" Click="FontColorButton_Click"
                                Style="{StaticResource NmButtonGhost}" Padding="4,2" Width="30" Height="28">
                            <StackPanel>
                                <TextBlock Text="A" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                <Border x:Name="FontColorIndicator" Height="3" Width="16" Background="Black" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HighlightColorButton" ToolTip="Color de resaltado" Click="HighlightColorButton_Click"
                                Style="{StaticResource NmButtonGhost}" Padding="4,2" Width="30" Height="28" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ab" FontSize="11" HorizontalAlignment="Center">
                                    <TextBlock.Background>
                                        <SolidColorBrush x:Name="HighlightPreviewBrush" Color="Yellow"/>
                                    </TextBlock.Background>
                                </TextBlock>
                                <Border x:Name="HighlightColorIndicator" Height="3" Width="16" Background="Yellow" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </ToolBar>

                    <!-- Row 2: Actions & Formatting -->
                    <ToolBar Background="Transparent" Band="1" BandIndex="0">
                        <Button Command="ApplicationCommands.Undo" Content="↩" ToolTip="Deshacer (Ctrl+Z)" Style="{StaticResource NmButtonGhost}" Padding="6,4"/>
                        <Button Command="ApplicationCommands.Redo" Content="↪" ToolTip="Rehacer (Ctrl+Y)" Style="{StaticResource NmButtonGhost}" Padding="6,4" Margin="2,0,0,0"/>
                        <Separator Margin="8,0"/>
                        <Button Command="ApplicationCommands.Cut" Content="Cortar" Style="{StaticResource NmButtonGhost}" Padding="8,4"/>
                        <Button Command="ApplicationCommands.Copy" Content="Copiar" Style="{StaticResource NmButtonGhost}" Padding="8,4" Margin="2,0,0,0"/>
                        <Button Command="ApplicationCommands.Paste" Content="Pegar" Style="{StaticResource NmButtonGhost}" Padding="8,4" Margin="2,0,0,0"/>
                        <Separator Margin="8,0"/>
                        <Button Command="EditingCommands.ToggleBold" ToolTip="Negrita (Ctrl+B)" Style="{StaticResource NmButtonGhost}" Width="28" Height="28">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                        </Button>
                        <Button Command="EditingCommands.ToggleItalic" ToolTip="Cursiva (Ctrl+I)" Style="{StaticResource NmButtonGhost}" Width="28" Height="28" Margin="2,0,0,0">
                            <TextBlock Text="I" FontStyle="Italic" FontSize="13"/>
                        </Button>
                        <Button Command="EditingCommands.ToggleUnderline" ToolTip="Subrayado (Ctrl+U)" Style="{StaticResource NmButtonGhost}" Width="28" Height="28" Margin="2,0,0,0">
                            <TextBlock Text="U" TextDecorations="Underline" FontSize="13"/>
                        </Button>
                        <Button x:Name="StrikethroughButton" ToolTip="Tachado" Click="StrikethroughButton_Click" Style="{StaticResource NmButtonGhost}" Width="28" Height="28" Margin="2,0,0,0">
                            <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="13"/>
                        </Button>
                        <Separator Margin="8,0"/>
                        <Button Command="EditingCommands.AlignLeft" Content="Izq" ToolTip="Alinear Izquierda" Style="{StaticResource NmButtonGhost}" Padding="6,4"/>
                        <Button Command="EditingCommands.AlignCenter" Content="Cent" ToolTip="Alinear Centro" Style="{StaticResource NmButtonGhost}" Padding="6,4" Margin="2,0,0,0"/>
                        <Button Command="EditingCommands.AlignRight" Content="Der" ToolTip="Alinear Derecha" Style="{StaticResource NmButtonGhost}" Padding="6,4" Margin="2,0,0,0"/>
                        <Button Command="EditingCommands.AlignJustify" Content="Just" ToolTip="Justificar" Style="{StaticResource NmButtonGhost}" Padding="6,4" Margin="2,0,0,0"/>
                        <Separator Margin="8,0"/>
                        <Button Command="EditingCommands.ToggleBullets" Content="Viñetas" ToolTip="Lista de Viñetas" Style="{StaticResource NmButtonGhost}" Padding="8,4"/>
                        <Button Command="EditingCommands.ToggleNumbering" Content="Números" ToolTip="Lista Numerada" Style="{StaticResource NmButtonGhost}" Padding="8,4" Margin="2,0,0,0"/>
                        <Separator Margin="8,0"/>
                        <Button Command="EditingCommands.DecreaseIndentation" Content="◄ Tab" Style="{StaticResource NmButtonGhost}" Padding="8,4"/>
                        <Button Command="EditingCommands.IncreaseIndentation" Content="Tab ►" Style="{StaticResource NmButtonGhost}" Padding="8,4" Margin="2,0,0,0"/>
                        <Separator Margin="8,0"/>
                        <Button x:Name="InsertImageButton" Content="Imagen" ToolTip="Insertar Imagen" Style="{StaticResource NmButtonGhost}" Padding="8,4" Click="InsertImageButton_Click"/>
                    </ToolBar>
                </ToolBarTray>
            </Border>

            <!-- Sunken Neumorphic RichTextBox Writing Container -->
            <Grid Grid.Row="2" Margin="10,12,10,0">
                <Border CornerRadius="12" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0"/>
                <Border CornerRadius="12" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5"/>
                <Border CornerRadius="12" Background="Transparent" Padding="8">
                    <RichTextBox x:Name="EditorRichTextBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource NmTextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="14.5"
                                 FontFamily="Segoe UI"
                                 Padding="12"
                                 VerticalAlignment="Stretch"
                                 TextChanged="EditorRichTextBox_TextChanged"
                                 SelectionChanged="EditorRichTextBox_SelectionChanged"
                                 PreviewMouseLeftButtonUp="EditorRichTextBox_PreviewMouseLeftButtonUp"
                                 AcceptsReturn="True"
                                 IsDocumentEnabled="True">
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="Comienza a escribir tu increíble historia aquí..."/>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Border>
            </Grid>

            <!-- Footer: Word count + save status -->
            <Border Grid.Row="3" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding IsSaving, Converter={StaticResource BoolToVis}, FallbackValue=''}"
                               Foreground="{DynamicResource NmTextSecondaryBrush}"
                               Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NmLabelText}">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Text" Value="Guardando..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource NmAccentBrush}" Style="{StaticResource NmLabelText}" FontWeight="SemiBold"
                               HorizontalAlignment="Left" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    
                    <Border Grid.Column="2" Padding="8,3" Margin="0,0,12,0" CornerRadius="10"
                            Background="#26FF7675" VerticalAlignment="Center"
                            Visibility="{Binding HasUnsavedOfflineChanges, Converter={StaticResource BoolToVis}}"
                            ToolTip="No se pudo contactar al servicio de worldbuilding. Ctrl+S para reintentar.">
                        <TextBlock Text="⚠ SIN CONEXIÓN" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource NmErrorBrush}"/>
                    </Border>
                    
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right"
                               Foreground="{DynamicResource NmTextSecondaryBrush}"
                               FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                               Text="{Binding WordCountText}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="3" Width="2" HorizontalAlignment="Stretch"
                      Background="{DynamicResource NmShadowDarkBrush}" Cursor="SizeWE"/>

        <!-- ═══ RIGHT SIDEBAR: Context Panel + Version History (Wrapped in Neumorphic Cards) ═══ -->
        <Border Grid.Column="4" Background="{DynamicResource NmSurfaceBrush}"
                BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1,0,0,0">
            <TabControl Background="Transparent" BorderThickness="0" Margin="5">
                <!-- ═══ TAB 1: CONTEXT (Wiki Mentions) ═══ -->
                <TabItem Header="Contexto" Cursor="Hand" Padding="14,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Mentions List -->
                        <ListBox Grid.Row="0" x:Name="MentionsListBox"
                                 ItemsSource="{Binding CurrentMentions}"
                                 Background="Transparent" BorderThickness="0" Padding="5"
                                 SelectionChanged="MentionsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,4" CornerRadius="10"
                                            Background="{DynamicResource NmBgBaseBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="2" Direction="315" BlurRadius="4" Opacity="0.5"/>
                                        </Border.Effect>
                                        <Grid SnapsToDevicePixels="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Soft Pastel Indicator Dot -->
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource NmAccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Character">
                                                                <Setter Property="Background" Value="#A5D8FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Location">
                                                                <Setter Property="Background" Value="#B2F2BB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Event">
                                                                <Setter Property="Background" Value="#FFD8A8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Object">
                                                                <Setter Property="Background" Value="#E5DBFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Concept">
                                                                <Setter Property="Background" Value="#CFD8DC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource NmTitleText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding EntityType}" Style="{StaticResource NmLabelText}" FontSize="11" Foreground="{DynamicResource NmTextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Grid.Row="0" Text="No se detectan entidades en este capítulo todavía.&#x0a;&#x0a;Crea entradas wiki para vincularlas de forma automática cuando escribas sus nombres."
                                   TextAlignment="Center" TextWrapping="Wrap" Padding="15,30"
                                   HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NmBodyText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMentions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Pastel Color Legend -->
                        <Border Grid.Row="1" Padding="10,12" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,1,0,0">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#A5D8FF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Personaje" FontSize="9" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#B2F2BB" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lugar" FontSize="9" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#FFD8A8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Suceso" FontSize="9" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#E5DBFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Objeto" FontSize="9" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#CFD8DC" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Concepto" FontSize="9" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ═══ TAB 2: HISTORY (Timeline Diff) ═══ -->
                <TabItem Header="Historial" Cursor="Hand" Padding="14,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Action Bar: Create Snapshot Milestone -->
                        <Border Grid.Row="0" Padding="5,10" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1">
                            <Button Content="Crear Hito Narrativo ⭐️"
                                    Click="CreateMilestoneButton_Click"
                                    Style="{StaticResource NmButtonPrimary}" Padding="10,8" FontSize="11.5" FontWeight="SemiBold"
                                    Cursor="Hand" HorizontalAlignment="Stretch"/>
                        </Border>

                        <!-- Timeline List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding ChapterVersions}"
                                 Background="Transparent" BorderThickness="0" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,4" CornerRadius="10" Background="{DynamicResource NmBgBaseBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="2" Direction="315" BlurRadius="4" Opacity="0.5"/>
                                        </Border.Effect>
                                        <Grid SnapsToDevicePixels="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Date & Type badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                                
                                                <!-- Soft Round Milestone Badge -->
                                                <Border Grid.Column="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#20A29BFE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                                                    <Setter Property="Background" Value="#2600B894"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="8" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="AUTOSAVE"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMilestone}" Value="True">
                                                                        <Setter Property="Text" Value="HITO"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource NmSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Author metadata -->
                                            <TextBlock Grid.Row="1" Text="{Binding CreatedBy, StringFormat='Por: {0}'}"
                                                       Style="{StaticResource NmLabelText}" FontSize="10.5" Foreground="{DynamicResource NmTextSecondaryBrush}" Margin="0,4,0,10"/>

                                            <!-- Actions -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Comparar"
                                                        Command="{Binding DataContext.CompareDiffCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NmButtonGhost}" Margin="0,0,4,0" Padding="5,4" FontSize="10" Cursor="Hand"/>
                                                <Button Grid.Column="1" Content="Restaurar"
                                                        Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmSuccessBrush}" Margin="4,0,0,0" Padding="5,4" FontSize="10" Cursor="Hand"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Grid.Row="1" Text="No hay versiones en el historial aún."
                                   Padding="15,30" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NmBodyText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChapterVersions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ═══ COLOR PICKER POPUP ═══ -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Background="{DynamicResource NmSurfaceBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ColorPickerTitle" Text="Color de fuente" Style="{StaticResource NmLabelText}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NmTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ColorPalettePanel" Width="200"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
