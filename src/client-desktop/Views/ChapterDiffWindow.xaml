<Window x:Class="Layla.Desktop.Views.ChapterDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparación de Versiones - Layla" Width="850" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NmBgBaseBrush}"
        Foreground="{DynamicResource NmTextPrimaryBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Neumorphic Header Card -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <!-- Light shadow border -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="3" Direction="135" BlurRadius="6" Opacity="0.9"/>
                </Border.Effect>
            </Border>
            <!-- Dark shadow border -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="3" Direction="315" BlurRadius="6" Opacity="0.5"/>
                </Border.Effect>
            </Border>
            
            <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="COMPARACIÓN DE VERSIONES" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionInfoText" Text="Comparando versión guardada con el texto actual del editor" Style="{StaticResource NmTitleText}" FontSize="14.5" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Style="{StaticResource NmButtonPrimary}" Content="Restaurar esta versión" Padding="18,8" VerticalAlignment="Center" Click="RestoreButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Legend (Soft desaturated pill style) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,15" Orientation="Horizontal">
            <Border CornerRadius="12" Background="#26D63031" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CONTENIDO ELIMINADO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmErrorBrush}" FontSize="9.5" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <Border CornerRadius="12" Background="#2600B894" Padding="12,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CONTENIDO AÑADIDO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmSuccessBrush}" FontSize="9.5" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Diff Viewer (Inset Sunken Container) -->
        <Grid Grid.Row="2">
            <Border CornerRadius="12" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0"/>
            <Border CornerRadius="12" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5"/>
            <Border CornerRadius="12" Background="Transparent" Padding="10">
                <RichTextBox x:Name="DiffRichTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="13.5" FontFamily="Segoe UI" Foreground="{DynamicResource NmTextPrimaryBrush}" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="DiffFlowDocument">
                        <Paragraph x:Name="DiffParagraph">
                            <!-- Diff runs will be injected dynamically -->
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </Border>
        </Grid>

        <!-- Footer -->
        <Button Grid.Row="3" Style="{StaticResource NmButtonGhost}" Content="Cerrar Panel" Width="120" HorizontalAlignment="Right" Margin="0,15,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
