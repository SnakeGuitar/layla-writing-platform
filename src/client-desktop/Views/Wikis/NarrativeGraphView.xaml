<Page x:Class="Layla.Desktop.Views.Wikis.NarrativeGraphView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="NarrativeGraphView"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Elegant Header -->
        <Border Padding="20,12" Background="{DynamicResource NmSurfaceBrush}"
                BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Grafo Narrativo" Style="{StaticResource NmTitleText}" FontSize="20" Foreground="{DynamicResource NmAccentBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmTextSecondaryBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Clean Pastel Legend -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#A5D8FF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Personaje" Style="{StaticResource NmLabelText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#B2F2BB" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lugar" Style="{StaticResource NmLabelText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#FFD8A8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Suceso" Style="{StaticResource NmLabelText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#E5DBFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Objeto" Style="{StaticResource NmLabelText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#CFD8DC" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Concepto" Style="{StaticResource NmLabelText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="AddRelationshipButton" Content="Añadir Relación" Command="{Binding OpenAddRelationshipCommand}"
                            Style="{StaticResource NmButtonGhost}" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                    
                    <Button Content="Actualizar" Command="{Binding LoadGraphCommand}"
                            Style="{StaticResource NmButtonPrimary}"
                            Padding="14,6" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Neumorphic Canvas Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource NmBgBaseBrush}">
            <Canvas x:Name="GraphCanvas" Width="1200" Height="800"
                    Background="{DynamicResource NmBgBaseBrush}" Margin="20"
                    MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                    MouseMove="GraphCanvas_MouseMove"
                    MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"/>
        </ScrollViewer>

        <!-- ═══ Add Relationship Modal Overlay ═══ -->
        <Border Visibility="{Binding IsAddRelationshipVisible, Converter={StaticResource BoolToVis}}"
                Background="#AA141420" Panel.ZIndex="100" Grid.RowSpan="2">
            <Grid Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Light shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <!-- Dark shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="12" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                
                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Añadir Relación" Style="{StaticResource NmTitleText}" FontSize="20" Margin="0,0,0,20" Foreground="{DynamicResource NmAccentBrush}"/>

                        <TextBlock Text="ENTIDAD ORIGEN:" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableEntities}"
                                   SelectedItem="{Binding NewRelSource}"
                                   DisplayMemberPath="Name" Height="38" Margin="0,0,0,15"/>

                        <TextBlock Text="ENTIDAD DESTINO:" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding AvailableEntities}"
                                   SelectedItem="{Binding NewRelTarget}"
                                   DisplayMemberPath="Name" Height="38" Margin="0,0,0,15"/>

                        <TextBlock Text="TIPO DE RELACIÓN:" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding RelationshipTypes}"
                                   SelectedItem="{Binding NewRelType}" Height="38" Margin="0,0,0,15"/>

                        <TextBlock Text="DESCRIPCIÓN / ETIQUETA (OPCIONAL):" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox Style="{StaticResource NmInputStyle}" Text="{Binding NewRelLabel, UpdateSourceTrigger=PropertyChanged}"
                                  Height="38" Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding AddRelError}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmErrorBrush}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource NmButtonGhost}" Padding="16,8" Margin="0,0,8,0" Cursor="Hand"
                                    Command="{Binding CancelAddRelationshipCommand}"/>
                            <Button Content="Crear Relación" Style="{StaticResource NmButtonPrimary}" Padding="18,8"
                                    Cursor="Hand" Command="{Binding ConfirmAddRelationshipCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
