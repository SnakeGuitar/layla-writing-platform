<Page x:Class="Layla.Desktop.Views.Projects.PublicProjectsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      ShowsNavigationUI="False"
      Title="Public Projects"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent" Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Clean Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Proyectos públicos" Style="{StaticResource NmDisplayText}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource NmAccentBrush}"/>
                <TextBlock Text="Explora e incorpórate a otros proyectos colaborativos" Style="{StaticResource NmBodyText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Volver a mis proyectos" Style="{StaticResource NmButtonGhost}"
                    Padding="14,8" Cursor="Hand" Command="{Binding BackToMyProjectsCommand}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Public Projects list with Neumorphic Cards -->
        <ListView Grid.Row="1" ItemsSource="{Binding PublicProjects}" BorderThickness="0" Background="Transparent"
                  x:Name="PublicProjectsList" MouseDoubleClick="PublicProjectsList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,10,10,18">
                        <!-- Light shadow border -->
                        <Border CornerRadius="12" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <!-- Dark shadow border -->
                        <Border CornerRadius="12" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>

                        <!-- Content card surface -->
                        <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource NmTitleText}" FontSize="18" Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                        <!-- Soft rounded Active badge -->
                                        <Border CornerRadius="12" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" Background="#2655EFC4"
                                                Visibility="{Binding IsAuthorActive, Converter={StaticResource BoolToVis}}" ToolTip="Author is active">
                                            <TextBlock Text="ACTIVO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmSuccessBrush}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LiteraryGenre}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Synopsis}" Style="{StaticResource NmBodyText}" TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,4" LineHeight="18"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                    <Button Content="Visualizar" Style="{StaticResource NmButtonGhost}"
                                            Padding="14,8" Margin="0,0,6,0" Cursor="Hand"
                                            Command="{Binding DataContext.ViewProjectCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Unirse" Style="{StaticResource NmButtonPrimary}"
                                            Padding="16,8" Cursor="Hand"
                                            Command="{Binding DataContext.JoinProjectCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" Padding="0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
