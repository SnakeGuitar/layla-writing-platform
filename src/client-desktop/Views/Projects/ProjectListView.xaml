<Page x:Class="Layla.Desktop.Views.Projects.ProjectListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Layla.Desktop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="ProjectListView"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">
    
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent" Margin="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header panel card -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <!-- Neumorphic shadows -->
                <Border CornerRadius="18" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="18" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="12" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="18" Background="{DynamicResource NmSurfaceBrush}" Padding="26,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Mis proyectos" Style="{StaticResource NmDisplayText}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource NmAccentBrush}"/>
                            <TextBlock Text="Gestiona y colabora en tus manuscritos" Style="{StaticResource NmBodyText}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Explorar públicos" Style="{StaticResource NmButtonGhost}"
                                    Padding="14,8" Cursor="Hand" Click="BrowsePublicButton_Click" Margin="0,0,6,0"/>
                            <Button Content="Crear proyecto" Style="{StaticResource NmButtonPrimary}"
                                    Padding="16,8" Cursor="Hand" Command="{Binding OpenCreateModalCommand}" Margin="0,0,6,0"/>
                            <Button Content="Configuración" Style="{StaticResource NmButtonGhost}"
                                    Padding="14,8" Cursor="Hand" Click="SettingsButton_Click" Margin="0,0,6,0"/>
                            <Button Content="Cerrar sesión" Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmErrorBrush}"
                                    Padding="14,8" Cursor="Hand" Click="LogoutButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Neumorphic Project Cards List -->
            <ListView x:Name="ProjectsListView" Grid.Row="1" ItemsSource="{Binding Projects}" BorderThickness="0" Background="Transparent" MouseDoubleClick="ProjectsListView_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Grid holding the double-shadow neumorphic card -->
                        <Grid Margin="10,10,10,20">
                            <!-- Light shadow border -->
                            <Border CornerRadius="12" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <!-- Dark shadow border -->
                            <Border CornerRadius="12" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                            
                            <!-- Content card surface -->
                            <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="20,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Genre + Role/Public badges -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LiteraryGenre}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="12" Padding="10,4" Margin="8,0,0,0" Background="#20A29BFE">
                                                <TextBlock Text="PÚBLICO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UserRole}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UserRole}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UserRole}" Value="OWNER">
                                                                <Setter Property="Background" Value="#2655EFC4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UserRole}" Value="EDITOR">
                                                                <Setter Property="Background" Value="#26A29BFE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding UserRole}" Value="READER">
                                                                <Setter Property="Background" Value="#269090A8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UserRole}" FontSize="9" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NmLabelText}">
                                                            <Setter Property="Foreground" Value="{DynamicResource NmTextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UserRole}" Value="OWNER">
                                                                    <Setter Property="Foreground" Value="{DynamicResource NmSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserRole}" Value="EDITOR">
                                                                    <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserRole}" Value="READER">
                                                                    <Setter Property="Foreground" Value="{DynamicResource NmTextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Title (left) + Action buttons (right, same baseline) -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource NmTitleText}" FontSize="20" Foreground="{DynamicResource NmTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Button Content="Abrir" Style="{StaticResource NmButtonPrimary}" Padding="16,8" Cursor="Hand" Click="OpenButton_Click"/>
                                            <Button Content="Editar" Style="{StaticResource NmButtonGhost}" Padding="14,8" Cursor="Hand" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.OpenEditModalCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                            <Button Content="Eliminar" Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmErrorBrush}" Padding="14,8" Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 4: Synopsis -->
                                    <TextBlock Grid.Row="4" Text="{Binding Synopsis}" Style="{StaticResource NmBodyText}" TextWrapping="Wrap" LineHeight="18"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <!-- Make standard ListBoxItem look perfectly flat in ListView -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" Padding="0">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Create Project Modal -->
        <Border x:Name="CreateProjectModal" Visibility="{Binding IsCreateModalVisible, Converter={StaticResource BoolToVis}}" Background="#AA141420" Panel.ZIndex="100" Margin="-30">
            <Grid Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Light shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <!-- Dark shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="12" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                
                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="25">
                    <StackPanel>
                        <TextBlock Text="Crear nuevo proyecto" Style="{StaticResource NmTitleText}" FontSize="20" Margin="0,0,0,20" Foreground="{DynamicResource NmAccentBrush}"/>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="TÍTULO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="NewProjectTitle" Style="{StaticResource NmInputStyle}" Text="{Binding NewProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="GÉNERO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="NewProjectGenre" Style="{StaticResource NmInputStyle}" Text="{Binding NewProjectGenre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="SINOPSIS" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="NewProjectSynopsis" Style="{StaticResource NmInputStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     Text="{Binding NewProjectSynopsis, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <CheckBox Content="Proyecto público" IsChecked="{Binding NewProjectIsPublic}" Foreground="{DynamicResource NmTextPrimaryBrush}" Margin="0,4,0,20"/>

                        <TextBlock x:Name="CreateProjectError" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmErrorBrush}" Visibility="{Binding CreateError, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,0,0,15"
                                   Text="{Binding CreateError}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource NmButtonGhost}" Padding="16,8" Cursor="Hand" Command="{Binding CloseCreateModalCommand}"/>
                            <Button x:Name="SaveProjectButton" Content="Crear" Style="{StaticResource NmButtonPrimary}" Padding="18,8" Cursor="Hand" Command="{Binding CreateProjectCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Edit Project Modal -->
        <Border x:Name="EditProjectModal" Visibility="{Binding IsEditModalVisible, Converter={StaticResource BoolToVis}}" Background="#AA141420" Panel.ZIndex="100" Margin="-30">
            <Grid Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Light shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <!-- Dark shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="12" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                
                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="25">
                    <StackPanel>
                        <TextBlock Text="Editar proyecto" Style="{StaticResource NmTitleText}" FontSize="20" Margin="0,0,0,20" Foreground="{DynamicResource NmAccentBrush}"/>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="TÍTULO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="EditProjectTitle" Style="{StaticResource NmInputStyle}" Text="{Binding EditProjectTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="GÉNERO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="EditProjectGenre" Style="{StaticResource NmInputStyle}" Text="{Binding EditProjectGenre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="SINOPSIS" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <TextBox x:Name="EditProjectSynopsis" Style="{StaticResource NmInputStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     Text="{Binding EditProjectSynopsis, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <CheckBox Content="Proyecto público" IsChecked="{Binding EditProjectIsPublic}" Foreground="{DynamicResource NmTextPrimaryBrush}" Margin="0,4,0,20"/>

                        <TextBlock x:Name="EditProjectError" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmErrorBrush}" Visibility="{Binding EditError, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,0,0,15"
                                   Text="{Binding EditError}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource NmButtonGhost}" Padding="16,8" Cursor="Hand" Command="{Binding CloseEditModalCommand}"/>
                            <Button x:Name="UpdateProjectButton" Content="Guardar" Style="{StaticResource NmButtonPrimary}" Padding="18,8" Cursor="Hand" Command="{Binding UpdateProjectCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
