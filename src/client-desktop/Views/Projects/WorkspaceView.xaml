<Page x:Class="Layla.Desktop.Views.Projects.WorkspaceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Layla.Desktop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="Workspace"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="240" MaxWidth="400"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Elegant Neumorphic Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource NmSurfaceBrush}" 
                BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Project Title & Badge -->
                <Grid Grid.Row="0" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentProject.Title}" Style="{StaticResource NmTitleText}" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource NmAccentBrush}"/>
                    <Border Grid.Column="1" Background="#20A29BFE" CornerRadius="8" Padding="6,3" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="PRJ" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontSize="8" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- Clean Navigation Buttons -->
                <StackPanel Grid.Row="1" Margin="20,10,20,0">
                    <Button Content="Volver a Proyectos" 
                            Style="{StaticResource NmButtonGhost}"
                            HorizontalAlignment="Stretch" Padding="12,10"
                            Cursor="Hand"
                            Command="{Binding BackToProjectsCommand}"/>
                    <Button Content="Colaboradores" 
                            Style="{StaticResource NmButtonPrimary}"
                            HorizontalAlignment="Stretch" Padding="12,10" Margin="0,12,0,0"
                            Cursor="Hand"
                            Command="{Binding OpenCollaboratorsModalCommand}"/>
                    <Button Content="Configuración" 
                            Style="{StaticResource NmButtonGhost}"
                            HorizontalAlignment="Stretch" Padding="12,10" Margin="0,12,0,0"
                            Cursor="Hand"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="2" Background="Transparent" />

                <!-- Disconnect Session Button -->
                <Border Grid.Row="3" Padding="20,0,20,20" Background="Transparent">
                    <Button Content="Desconectar Sesión" 
                            Style="{StaticResource NmButtonGhost}"
                            Foreground="{DynamicResource NmErrorBrush}"
                            HorizontalAlignment="Stretch" Padding="0,10"
                            Cursor="Hand"
                            Command="{Binding LogoutCommand}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" 
                      Background="{DynamicResource NmShadowDarkBrush}" Cursor="SizeWE"/>

        <!-- Main Workspace Area -->
        <Grid Grid.Column="2" Background="Transparent" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Clean Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1" Padding="10,20,20,15" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="LAYLA // ESCRITORIO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="•" Foreground="{DynamicResource NmTextSecondaryBrush}" Style="{StaticResource NmLabelText}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Espacio de escritura colaborativa" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SISTEMA ACTIVO" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmSuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource NmSuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Workspace Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <TabItem Header="MANUSCRITOS">
                    <Frame x:Name="EditorFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="BASE WIKI">
                    <Frame x:Name="WikiFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="GRAFO NARRATIVO">
                    <Frame x:Name="GraphFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="SALA DE VOZ">
                    <Frame x:Name="VoiceFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Collaborators Modal Overlay -->
        <Border Visibility="{Binding IsCollaboratorsModalVisible, Converter={StaticResource BoolToVis}}"
                Background="#AA141420" Panel.ZIndex="100" Grid.ColumnSpan="3">
            <Grid Width="500" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Light shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <!-- Dark shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="12" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                
                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Colaboradores" Style="{StaticResource NmTitleText}" FontSize="20"
                                   Foreground="{DynamicResource NmAccentBrush}" Margin="0,0,0,15"/>

                        <!-- Invite Section -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="INVITAR POR CORREO ELECTRÓNICO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NmInputStyle}"
                                         Text="{Binding InviteEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Enviar Invitación" Margin="8,0,0,0"
                                        Style="{StaticResource NmButtonPrimary}" Padding="15,6" Cursor="Hand"
                                        Command="{Binding InviteCollaboratorCommand}"/>
                                </Grid>
                            <TextBlock Text="{Binding InviteError}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmErrorBrush}"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding InviteError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Collaborators List -->
                        <ListView Grid.Row="2" ItemsSource="{Binding Collaborators}" BorderThickness="0"
                                   Background="Transparent" MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,0,1"
                                            Padding="5,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource NmTitleText}" FontSize="13" Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Email}" Style="{StaticResource NmBodyText}" FontSize="11"
                                                           Foreground="{DynamicResource NmTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="12" Padding="8,3" Background="#26A29BFE" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding Role}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmAccentBrush}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="Eliminar" Style="{StaticResource NmButtonGhost}" Foreground="{DynamicResource NmErrorBrush}" Padding="8,4" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveCollaboratorCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource NmButtonGhost}"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Right"
                                Margin="0,15,0,0" Command="{Binding CloseCollaboratorsModalCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
