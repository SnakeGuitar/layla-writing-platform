<Page x:Class="Layla.Desktop.Views.Projects.WorkspaceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Layla.Desktop.Views"
      xmlns:conv="clr-namespace:Layla.Desktop.Converters"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="Workspace"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:AvatarUrlConverter x:Key="AvatarUrlConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="52" MaxWidth="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             Collapsible Sidebar
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource NmSurfaceBrush}"
                BorderBrush="{DynamicResource NmShadowDarkBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: toggle button + project title -->
                <Grid Grid.Row="0" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar toggle button — Style="{x:Null}" bypasses the implicit
                         NmButtonPrimary style whose ContentPresenter.Resources override
                         TextBlock Foreground to White, making the glyph invisible. -->
                    <Button x:Name="ToggleSidebarButton"
                            Grid.Column="0"
                            Click="ToggleSidebar_Click"
                            Style="{x:Null}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="36" Height="36" Padding="0"
                            VerticalAlignment="Center"
                            ToolTip="Colapsar menú"
                            Cursor="Hand">
                        <TextBlock Text="☰" FontSize="16"
                                   Foreground="{DynamicResource NmAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <!-- Project title — hidden when collapsed -->
                    <TextBlock x:Name="SidebarTitleText"
                               Grid.Column="1"
                               Text="{Binding CurrentProject.Title}"
                               Style="{StaticResource NmTitleText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource NmAccentBrush}"
                               Margin="8,0,0,0"/>

                    <!-- PRJ badge — hidden when collapsed -->
                    <Border x:Name="SidebarBadge"
                            Grid.Column="2"
                            Background="#20A29BFE" CornerRadius="8"
                            Padding="6,3" VerticalAlignment="Center" Margin="5,0,4,0">
                        <TextBlock Text="PRJ"
                                   Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmAccentBrush}"
                                   FontSize="8" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- Navigation buttons -->
                <StackPanel Grid.Row="1" Margin="8,8,8,0">

                    <!-- Volver a Proyectos -->
                    <Button x:Name="BackBtn"
                            Style="{StaticResource NmButtonGhost}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,10"
                            Cursor="Hand"
                            ToolTip="Volver a Proyectos"
                            Command="{Binding BackToProjectsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BackBtnText"
                                       Text="Volver a Proyectos"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Colaboradores (owner only) -->
                    <Button x:Name="CollabBtn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,10" Margin="0,6,0,0"
                            Cursor="Hand"
                            ToolTip="Colaboradores"
                            Command="{Binding OpenCollaboratorsModalCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NmButtonPrimary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOwner}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CollabBtnText"
                                       Text="Colaboradores"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Configuración -->
                    <Button x:Name="SettingsBtn"
                            Style="{StaticResource NmButtonGhost}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,10" Margin="0,6,0,0"
                            Cursor="Hand"
                            ToolTip="Configuración"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsBtnText"
                                       Text="Configuración"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="2"/>

                <!-- Desconectar Sesión -->
                <Border Grid.Row="3" Padding="8,0,8,20">
                    <Button x:Name="LogoutBtn"
                            Style="{StaticResource NmButtonGhost}"
                            Foreground="{DynamicResource NmErrorBrush}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,10"
                            Cursor="Hand"
                            ToolTip="Desconectar Sesión"
                            Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LogoutBtnText"
                                       Text="Desconectar Sesión"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             Main Workspace Area
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="Transparent" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource NmShadowDarkBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,20,20,15"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="LAYLA // ESCRITORIO"
                                   Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmAccentBrush}"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="•"
                                   Foreground="{DynamicResource NmTextSecondaryBrush}"
                                   Style="{StaticResource NmLabelText}"
                                   VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Espacio de escritura colaborativa"
                                   Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Connected users avatar strip -->
                        <ItemsControl ItemsSource="{Binding ConnectedUsers}"
                                      VerticalAlignment="Center" Margin="0,0,12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Margin="-6,0,0,0"
                                            BorderBrush="{DynamicResource NmBgBaseBrush}" BorderThickness="2"
                                            ToolTip="{Binding DisplayName}"
                                            Background="{DynamicResource NmSurfaceBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource NmAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="?"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayName}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="?"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border CornerRadius="15" ClipToBounds="True">
                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource AvatarUrlConverter}}"
                                                       Stretch="UniformToFill"
                                                       Width="30" Height="30"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="SISTEMA ACTIVO"
                                   Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmSuccessBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource NmSuccessBrush}"
                                 Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <TabItem Header="MANUSCRITOS">
                    <Frame x:Name="EditorFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="BASE WIKI">
                    <Frame x:Name="WikiFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="GRAFO NARRATIVO">
                    <Frame x:Name="GraphFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
                <TabItem Header="SALA DE VOZ">
                    <Frame x:Name="VoiceFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             Collaborators Modal Overlay
             ══════════════════════════════════════════════════════ -->
        <Border Visibility="{Binding IsCollaboratorsModalVisible, Converter={StaticResource BoolToVis}}"
                Background="#AA141420" Panel.ZIndex="100" Grid.ColumnSpan="2">
            <Grid Width="500" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="12" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="12" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Colaboradores"
                                   Style="{StaticResource NmTitleText}" FontSize="20"
                                   Foreground="{DynamicResource NmAccentBrush}" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="INVITAR POR CORREO ELECTRÓNICO"
                                       Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource NmInputStyle}"
                                         Text="{Binding InviteEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Enviar Invitación" Margin="8,0,0,0"
                                        Style="{StaticResource NmButtonPrimary}" Padding="15,6" Cursor="Hand"
                                        Command="{Binding InviteCollaboratorCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding InviteError}"
                                       Style="{StaticResource NmLabelText}"
                                       Foreground="{DynamicResource NmErrorBrush}"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding InviteError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <ListView Grid.Row="2" ItemsSource="{Binding Collaborators}"
                                  BorderThickness="0" Background="Transparent"
                                  MaxHeight="250"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource NmShadowDarkBrush}"
                                            BorderThickness="0,0,0,1" Padding="5,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource NmTitleText}" FontSize="13"
                                                           Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Email}"
                                                           Style="{StaticResource NmBodyText}" FontSize="11"
                                                           Foreground="{DynamicResource NmTextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                <Border CornerRadius="12" Padding="8,3" Background="#2655EFC4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="OWNER">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="OWNER"
                                                               Style="{StaticResource NmLabelText}"
                                                               Foreground="{DynamicResource NmSuccessBrush}"
                                                               FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <ComboBox SelectedItem="{Binding Role, Mode=OneWay}"
                                                          FontSize="10" MinWidth="72"
                                                          Tag="{Binding}"
                                                          SelectionChanged="CollaboratorRoleComboBox_SelectionChanged">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="OWNER">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                    <ComboBoxItem Content="READER"/>
                                                    <ComboBoxItem Content="EDITOR"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Grid.Column="2" Content="Eliminar"
                                                    Style="{StaticResource NmButtonGhost}"
                                                    Foreground="{DynamicResource NmErrorBrush}"
                                                    Padding="8,4" Cursor="Hand" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveCollaboratorCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <Button Grid.Row="3" Content="Cerrar"
                                Style="{StaticResource NmButtonGhost}"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Right"
                                Margin="0,15,0,0"
                                Command="{Binding CloseCollaboratorsModalCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
