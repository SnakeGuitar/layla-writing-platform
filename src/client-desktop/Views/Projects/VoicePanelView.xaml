<Page x:Class="Layla.Desktop.Views.Projects.VoicePanelView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Voice Room"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Connection status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusIndicatorFill}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource NmLabelText}" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource NmTextSecondaryBrush}"/>
            
            <Button Content="{Binding ConnectButtonContent}" Margin="15,0,0,0" Style="{StaticResource NmButtonPrimary}"
                    Padding="12,6" Cursor="Hand" Command="{Binding ConnectCommand}"
                    Visibility="{Binding IsConnectVisible, Converter={StaticResource BoolToVis}}"/>
            
            <Button Content="Salir de la Sala" Margin="10,0,0,0" Style="{StaticResource NmButtonGhost}"
                    Foreground="{DynamicResource NmErrorBrush}"
                    Padding="12,6" Cursor="Hand" Command="{Binding LeaveCommand}"
                    Visibility="{Binding IsLeaveVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Online Now (Presence) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15" 
                        Visibility="{Binding IsOnlineParticipantsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Participantes Conectados" Style="{StaticResource NmTitleText}" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource NmAccentBrush}"/>
                
                <ItemsControl ItemsSource="{Binding OnlineParticipants}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="8,4" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="2" Direction="315" BlurRadius="4" Opacity="0.5"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource NmSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Participant list card (Voice) -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <!-- Light shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
                <!-- Dark shadow border -->
                <Border CornerRadius="12" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                
                <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="15">
                    <Grid SnapsToDevicePixels="True">
                        <TextBlock Visibility="{Binding IsEmptyRoomVisible, Converter={StaticResource BoolToVis}}" Text="No hay participantes en la sala de voz" Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        
                        <ListBox x:Name="ParticipantList" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Participants}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,6">
                                        <!-- Soft circle indicator for speaking -->
                                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource NmShadowDarkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NmSuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                            </Border.Effect>
                                        </Border>
                                        
                                        <!-- Participant Display Name -->
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource NmTitleText}" FontSize="13.5"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource NmTextPrimaryBrush}"/>
                                        
                                        <!-- Participant Role Badge -->
                                        <Border CornerRadius="10" Padding="8,2" Background="#20A29BFE" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource NmLabelText}" FontSize="9"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource NmAccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="0">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Circular Neumorphic PTT Button -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="PttButton" Width="160" Height="160"
                    IsEnabled="{Binding IsPttEnabled}" Cursor="Hand"
                    PreviewMouseDown="PttButton_MouseDown"
                    PreviewMouseUp="PttButton_MouseUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PttGrid">
                            <!-- Raised Shadows (Normal state) -->
                            <Border x:Name="ShadowLight" CornerRadius="80" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ShadowDark" CornerRadius="80" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <!-- Sunken Inset Shadows (Pressed state) -->
                            <Border x:Name="SunkenDark" CornerRadius="80" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="2,2,0,0" Visibility="Collapsed"/>
                            <Border x:Name="SunkenLight" CornerRadius="80" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,2,2" Visibility="Collapsed"/>

                            <!-- Main button circle -->
                            <Border x:Name="PttBorder" CornerRadius="80" Background="{DynamicResource NmSurfaceBrush}" Padding="15">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PttText" Text="PTT" Style="{StaticResource NmDisplayText}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NmTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PttHint" Text="Pulsa para hablar" Style="{StaticResource NmLabelText}" FontSize="11"
                                               Foreground="{DynamicResource NmTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Pressed State Trigger -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ShadowLight" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ShadowDark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SunkenDark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SunkenLight" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PttBorder" Property="Background" Value="Transparent"/>
                                <Setter TargetName="PttText" Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                <Setter TargetName="PttHint" Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PttGrid" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <TextBlock Text="{Binding PttStatusText}" Style="{StaticResource NmLabelText}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,12,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource NmTextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
