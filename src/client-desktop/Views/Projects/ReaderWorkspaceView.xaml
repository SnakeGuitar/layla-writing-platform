<Page x:Class="Layla.Desktop.Views.Projects.ReaderWorkspaceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="Reader Workspace"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource NmSurfaceBrush}"
                BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Project Title -->
                <TextBlock Grid.Row="0" Text="{Binding CurrentProject.Title}" Style="{StaticResource NmTitleText}"
                           VerticalAlignment="Center" Margin="20,20,20,10" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource NmAccentBrush}"/>

                <!-- Author Status Indicator -->
                <Border Grid.Row="1" Margin="20,0,20,15" Padding="12,6" CornerRadius="12" Background="{DynamicResource NmBgBaseBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource NmTextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthorActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NmSuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding AuthorStatusText}" Style="{StaticResource NmLabelText}" FontSize="11" Foreground="{DynamicResource NmTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Read-only Details & Badge -->
                <StackPanel Grid.Row="2" Margin="20,5">
                    <!-- Soft round "Solo lectura" pill badge -->
                    <Border CornerRadius="12" Padding="12,6" Margin="0,0,0,20" Background="#269090A8" HorizontalAlignment="Center">
                        <TextBlock Text="Solo lectura" Style="{StaticResource NmLabelText}"
                                   Foreground="{DynamicResource NmTextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="10"/>
                    </Border>

                    <TextBlock Text="{Binding CurrentProject.Synopsis}" Style="{StaticResource NmBodyText}" TextWrapping="Wrap" Margin="0,0,0,15" LineHeight="18"/>
                    
                    <TextBlock Style="{StaticResource NmLabelText}" Foreground="{DynamicResource NmTextSecondaryBrush}" Margin="0,0,0,20">
                        <Run Text="GÉNERO: " FontWeight="SemiBold"/><Run Text="{Binding CurrentProject.LiteraryGenre}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <Button Content="Volver a Públicos" Style="{StaticResource NmButtonGhost}"
                            HorizontalAlignment="Stretch" Padding="10,8" Cursor="Hand"
                            Command="{Binding BackToPublicProjectsCommand}"/>
                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Row="3" Content="Cerrar sesión" Style="{StaticResource NmButtonGhost}"
                        Foreground="{DynamicResource NmErrorBrush}"
                        HorizontalAlignment="Stretch" Padding="15,10" Margin="20" Cursor="Hand"
                        Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch"
                      Background="{DynamicResource NmShadowDarkBrush}" Cursor="SizeWE"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="2" Background="Transparent" Margin="20,0,0,0">
            <TabControl Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <TabItem Header="MANUSCRITO">
                    <Frame x:Name="EditorFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="WIKI">
                    <Frame x:Name="WikiFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="GRAFO">
                    <Frame x:Name="GraphFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>

                <TabItem Header="VOZ">
                    <Frame x:Name="VoiceFrame" NavigationUIVisibility="Hidden"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
