<Page x:Class="Layla.Desktop.Views.User.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Layla.Desktop.Views.User"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="Settings"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:AvatarUrlConverter x:Key="AvatarUrlConverter"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Navigation Button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <Button Content="Volver al espacio de trabajo" Style="{StaticResource NmButtonGhost}" 
                    Padding="12,6" Cursor="Hand" Command="{Binding GoBackCommand}"/>
        </StackPanel>

        <!-- Screen Title -->
        <TextBlock Grid.Row="1" Text="Configuración" Style="{StaticResource NmDisplayText}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,30"/>

        <!-- Settings Cards Layout -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Width="550" HorizontalAlignment="Left">

                <!-- CARD 0: PERFIL DE USUARIO -->
                <Grid Margin="0,0,0,32">
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Perfil" Style="{StaticResource NmTitleText}" Margin="0,0,0,20" Foreground="{DynamicResource NmAccentBrush}"/>

                            <!-- Avatar + initials row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">

                                <!-- Avatar circle -->
                                <Grid Width="72" Height="72" Margin="0,0,16,0">
                                    <!-- Initials fallback -->
                                    <Border Width="72" Height="72" CornerRadius="36"
                                            Background="{DynamicResource NmAccentBrush}">
                                        <TextBlock Text="{Binding ProfileInitials}"
                                                   FontSize="22" FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Image overlay — visible only when avatar is set -->
                                    <Border Width="72" Height="72" CornerRadius="36"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                                        <Border.OpacityMask>
                                            <RadialGradientBrush>
                                                <GradientStop Color="Black" Offset="0.88"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.OpacityMask>
                                        <Image Source="{Binding ProfileAvatarUrl, Converter={StaticResource AvatarUrlConverter}}"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>

                                <!-- Avatar actions -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfileDisplayName}" FontWeight="SemiBold"
                                               Style="{StaticResource NmBodyText}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding ProfileEmail, FallbackValue=''}"
                                               Style="{StaticResource NmBodyText}"
                                               Foreground="{DynamicResource NmTextSecondaryBrush}"
                                               FontSize="11" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Cambiar foto" Style="{StaticResource NmButtonGhost}"
                                                Padding="10,5" FontSize="11" Cursor="Hand"
                                                Command="{Binding PickAvatarCommand}"/>
                                        <Button Content="Quitar" Style="{StaticResource NmButtonGhost}"
                                                Padding="10,5" FontSize="11" Cursor="Hand" Margin="8,0,0,0"
                                                Foreground="{DynamicResource NmErrorBrush}"
                                                Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding RemoveAvatarCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Display Name field -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre público:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}" MaxLength="100"/>
                            </Grid>

                            <!-- Bio field -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Biografía:" Style="{StaticResource NmLabelText}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <TextBox Grid.Column="1" Text="{Binding ProfileBio, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}"
                                         Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" MaxLength="500"/>
                            </Grid>

                            <!-- Save row -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Guardar perfil" Style="{StaticResource NmButtonPrimary}"
                                        Padding="16,8" Cursor="Hand"
                                        Command="{Binding SaveProfileCommand}"/>
                                <TextBlock Text="{Binding ProfileSaveStatus}"
                                           Style="{StaticResource NmLabelText}"
                                           Foreground="{DynamicResource NmSuccessBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 1: APARIENCIA -->
                <Grid Margin="0,0,0,32">
                    <!-- Light shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <!-- Dark shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    
                    <!-- Content area -->
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Apariencia" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>
                            
                            <!-- Theme Selection -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tema de la aplicación:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                           SelectedValue="{Binding CurrentTheme}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Claro Neumórfico" Tag="LightTheme"/>
                                    <ComboBoxItem Content="Oscuro Neumórfico" Tag="NeumorphismTheme"/>
                                </ComboBox>
                            </Grid>

                            <!-- Fullscreen Mode -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Modo pantalla completa:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FullscreenCheckBox" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsFullscreen}" Content="Habilitar"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 2: VERSIÓN -->
                <Grid Margin="0,0,0,32">
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Versión" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Versión actual:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource NmBodyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Objetivo del milestone:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding MilestoneLabel}" Style="{StaticResource NmBodyText}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Estado:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding VersionStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NmLabelText}">
                                            <Setter Property="Foreground" Value="{DynamicResource NmSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVersionOnTarget}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource NmErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 3: CONEXIÓN -->
                <Grid Margin="0,0,0,32">
                    <!-- Light shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <!-- Dark shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    
                    <!-- Content area -->
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Conexión" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>
                            
                            <!-- Server Core URL -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="URL del Servidor Principal:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ServerCoreUrlBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding ServerCoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Worldbuilding URL -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="URL de Worldbuilding:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="WorldbuildingUrlBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding WorldbuildingUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Save Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <Button Content="Guardar conexión" Style="{StaticResource NmButtonPrimary}" Padding="16,8"
                                        Command="{Binding SaveConnectionCommand}" Cursor="Hand"/>
                                <TextBlock Text="{Binding ConnectionSaveStatus}" Style="{StaticResource NmLabelText}"
                                           Foreground="{DynamicResource NmSuccessBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Defaults Info -->
                            <TextBlock Style="{StaticResource NmBodyText}" FontSize="11" Foreground="{DynamicResource NmTextSecondaryBrush}">
                                Configuración por defecto: Server Core = https://localhost:5288 · Worldbuilding = http://localhost:3000
                                <LineBreak/>Entorno Docker: Server Core = https://localhost:5288 · Worldbuilding = http://localhost:3000
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
