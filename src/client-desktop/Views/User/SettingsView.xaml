<Page x:Class="Layla.Desktop.Views.User.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Layla.Desktop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      ShowsNavigationUI="False"
      Title="Settings"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back Navigation Button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <Button Content="Volver al espacio de trabajo" Style="{StaticResource NmButtonGhost}" 
                    Padding="12,6" Cursor="Hand" Command="{Binding GoBackCommand}"/>
        </StackPanel>

        <!-- Screen Title -->
        <TextBlock Grid.Row="1" Text="Configuración" Style="{StaticResource NmDisplayText}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,30"/>

        <!-- Settings Cards Layout -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Width="550" HorizontalAlignment="Left">
                                <!-- CARD 1: APARIENCIA -->
                <Grid Margin="0,0,0,32">
                    <!-- Light shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <!-- Dark shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    
                    <!-- Content area -->
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Apariencia" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>
                            
                            <!-- Theme Selection -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tema de la aplicación:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                           SelectedValue="{Binding CurrentTheme}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Claro Neumórfico" Tag="LightTheme"/>
                                    <ComboBoxItem Content="Oscuro Neumórfico" Tag="NeumorphismTheme"/>
                                </ComboBox>
                            </Grid>

                            <!-- Fullscreen Mode -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Modo pantalla completa:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="FullscreenCheckBox" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsFullscreen}" Content="Habilitar"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 2: VERSIÓN -->
                <Grid Margin="0,0,0,32">
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Versión" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Versión actual:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource NmBodyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Objetivo del milestone:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding MilestoneLabel}" Style="{StaticResource NmBodyText}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Estado:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding VersionStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NmLabelText}">
                                            <Setter Property="Foreground" Value="{DynamicResource NmSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVersionOnTarget}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource NmErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 3: CONEXIÓN -->
                <Grid Margin="0,0,0,32">
                    <!-- Light shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <!-- Dark shadow border -->
                    <Border CornerRadius="22" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    
                    <!-- Content area -->
                    <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Conexión" Style="{StaticResource NmTitleText}" Margin="0,0,0,18" Foreground="{DynamicResource NmAccentBrush}"/>
                            
                            <!-- Server Core URL -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="URL del Servidor Principal:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ServerCoreUrlBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding ServerCoreUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Worldbuilding URL -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="URL de Worldbuilding:" Style="{StaticResource NmLabelText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="WorldbuildingUrlBox" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding WorldbuildingUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NmInputStyle}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Save Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <Button Content="Guardar conexión" Style="{StaticResource NmButtonPrimary}" Padding="16,8"
                                        Command="{Binding SaveConnectionCommand}" Cursor="Hand"/>
                                <TextBlock Text="{Binding ConnectionSaveStatus}" Style="{StaticResource NmLabelText}"
                                           Foreground="{DynamicResource NmSuccessBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Defaults Info -->
                            <TextBlock Style="{StaticResource NmBodyText}" FontSize="11" Foreground="{DynamicResource NmTextSecondaryBrush}">
                                Configuración por defecto: Server Core = https://localhost:5288 · Worldbuilding = http://localhost:3000
                                <LineBreak/>Entorno Docker: Server Core = https://localhost:5288 · Worldbuilding = http://localhost:3000
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
