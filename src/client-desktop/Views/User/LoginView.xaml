<Page x:Class="Layla.Desktop.Views.User.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      ShowsNavigationUI="False"
      Title="Sign In"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left branding panel -->
            <ColumnDefinition Width="0.42*"/>
            <!-- Right form panel -->
            <ColumnDefinition Width="0.58*"/>
        </Grid.ColumnDefinitions>

        <!-- ─── Left branding panel ─── -->
        <Border Grid.Column="0" Background="{DynamicResource NmAccentBrush}">
            <Grid>
                <!-- Decorative circles (neumorphic ambient) -->
                <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-80,-80,0,0" Fill="#18FFFFFF"/>
                <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-60,-60" Fill="#12FFFFFF"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,40,0">
                    <TextBlock Text="Layla"
                               FontFamily="{DynamicResource InterfaceFont}"
                               FontSize="48" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,14"/>
                    <TextBlock Text="Tu espacio de escritura colaborativa"
                               FontFamily="{DynamicResource InterfaceFont}"
                               FontSize="15" Foreground="#DDFFFFFF"
                               TextWrapping="Wrap" Margin="0,0,0,36" LineHeight="22"/>

                    <!-- Feature bullets -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Editor de manuscritos en tiempo real"
                                       FontFamily="{DynamicResource InterfaceFont}"
                                       FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Wiki de worldbuilding y grafo narrativo"
                                       FontFamily="{DynamicResource InterfaceFont}"
                                       FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Sesiones de voz para co-escritura"
                                       FontFamily="{DynamicResource InterfaceFont}"
                                       FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── Right form panel ─── -->
        <Grid Grid.Column="1" Background="{DynamicResource NmBgBaseBrush}">
            <Grid Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <!-- Neumorphic Double Shadow Card -->
                <Border CornerRadius="22" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="6" Direction="135" BlurRadius="18" Opacity="0.95"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="22" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="6" Direction="315" BlurRadius="18" Opacity="0.7"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="22" Background="{DynamicResource NmSurfaceBrush}" Padding="35,38,35,32">
                    <StackPanel>
                        <TextBlock Text="Bienvenido de vuelta"
                                   Style="{StaticResource NmTitleText}" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <TextBlock Text="Inicia sesión para continuar escribiendo"
                                   Style="{StaticResource NmBodyText}"
                                   HorizontalAlignment="Left" Margin="0,0,0,28"/>

                        <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource NmInputStyle}" Margin="0,0,0,18"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource NmPasswordStyle}" Margin="0,0,0,24"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NmErrorBrush}"
                                   Style="{StaticResource NmLabelText}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                   HorizontalAlignment="Left" Margin="0,0,0,14"
                                   Text="{Binding ErrorMessage}"/>

                        <Button x:Name="LoginButton" Content="INICIAR SESIÓN" Height="42"
                                Cursor="Hand" Command="{Binding SignInCommand}"
                                Style="{StaticResource NmButtonPrimary}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <TextBlock Text="¿No tienes una cuenta? " Style="{StaticResource NmBodyText}"/>
                            <TextBlock Text="Crear un perfil" Style="{StaticResource NmBodyText}"
                                       Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold"
                                       Cursor="Hand" MouseLeftButtonDown="NavigateToSignUp_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
