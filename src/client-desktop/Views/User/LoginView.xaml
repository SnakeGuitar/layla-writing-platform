<Page x:Class="Layla.Desktop.Views.User.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      ShowsNavigationUI="False"
      Title="Sign In"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Neumorphic Double Shadow Card Panel -->
        <Grid Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <!-- Light shadow border (top-left) -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                </Border.Effect>
            </Border>
            <!-- Dark shadow border (bottom-right) -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                </Border.Effect>
            </Border>
            <!-- Content card surface -->
            <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="30,35,30,30">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Layla" Style="{StaticResource NmDisplayText}" FontSize="32" FontWeight="SemiBold"
                               HorizontalAlignment="Left" Foreground="{DynamicResource NmAccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Tu espacio de escritura colaborativa" Style="{StaticResource NmBodyText}" 
                               HorizontalAlignment="Left" Foreground="{DynamicResource NmTextSecondaryBrush}" Margin="0,0,0,25"/>

                    <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource NmInputStyle}" Margin="0,0,0,18"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="CONTRASEÑA" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource NmPasswordStyle}" Margin="0,0,0,25"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NmErrorBrush}" Style="{StaticResource NmLabelText}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" 
                               HorizontalAlignment="Left" Margin="0,0,0,15"
                               Text="{Binding ErrorMessage}"/>

                    <Button x:Name="LoginButton" Content="INICIAR SESIÓN" Height="42"
                            Cursor="Hand" Command="{Binding SignInCommand}"
                            Style="{StaticResource NmButtonPrimary}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                        <TextBlock Text="¿No tienes una cuenta? " Style="{StaticResource NmBodyText}"/>
                        <TextBlock Text="Crear un perfil" Style="{StaticResource NmBodyText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold"
                                   Cursor="Hand" MouseLeftButtonDown="NavigateToSignUp_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>