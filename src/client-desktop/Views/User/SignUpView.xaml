<Page x:Class="Layla.Desktop.Views.User.SignUpView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      ShowsNavigationUI="False"
      Title="Sign Up"
      Background="{DynamicResource NmBgBaseBrush}"
      Foreground="{DynamicResource NmTextPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <!-- Neumorphic Double Shadow Card Panel -->
        <Grid Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <!-- Light shadow border (top-left) -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="4" Direction="135" BlurRadius="8" Opacity="0.9"/>
                </Border.Effect>
            </Border>
            <!-- Dark shadow border (bottom-right) -->
            <Border CornerRadius="12" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                </Border.Effect>
            </Border>
            <!-- Content card surface -->
            <Border CornerRadius="12" Background="{DynamicResource NmSurfaceBrush}" Padding="35">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Layla" Style="{StaticResource NmDisplayText}" FontSize="32" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource NmAccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Crea tu perfil de escritor" Style="{StaticResource NmBodyText}" 
                               HorizontalAlignment="Center" Foreground="{DynamicResource NmTextSecondaryBrush}" Margin="0,0,0,25"/>

                    <!-- Circular 2-Step Stepper -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Step 1 Circle (Active by default, or subtle if step 2 is active) -->
                        <Border x:Name="Step1Circle" Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource NmBgBaseBrush}" BorderThickness="2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource NmAccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVerificationStep}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource NmShadowDarkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerificationStep}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NmTextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        
                        <!-- Stepper Line Connector -->
                        <Border Grid.Column="1" Height="2" Background="{DynamicResource NmShadowDarkBrush}" VerticalAlignment="Center"/>
                        
                        <!-- Step 2 Circle (Active when on verification step) -->
                        <Border x:Name="Step2Circle" Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource NmBgBaseBrush}" BorderThickness="2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource NmShadowDarkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVerificationStep}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource NmAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource NmTextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerificationStep}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Step 1 Form fields -->
                    <StackPanel Visibility="{Binding IsSignUpStep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DIRECCIÓN DE CORREO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="EmailTextBox" Style="{StaticResource NmInputStyle}" Margin="0,0,0,15"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="NOMBRE PÚBLICO" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="DisplayNameTextBox" Style="{StaticResource NmInputStyle}" Margin="0,0,0,15"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource NmPasswordStyle}" Margin="0,0,0,25"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                    </StackPanel>

                    <!-- Step 2 Form fields -->
                    <StackPanel Visibility="{Binding IsVerificationStep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CÓDIGO PIN DE VERIFICACIÓN" Style="{StaticResource NmLabelText}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="PinTextBox" Style="{StaticResource NmInputStyle}" MaxLength="6" Margin="0,0,0,25"
                                 Text="{Binding VerificationPin, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="16"/>
                    </StackPanel>

                    <!-- Feedback message -->
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center"
                               Foreground="{DynamicResource NmErrorBrush}" Style="{StaticResource NmLabelText}"
                               Text="{Binding StatusMessage}"/>

                    <!-- Action buttons -->
                    <Button x:Name="SignUpButton" Content="{Binding SignUpButtonContent}" Height="42" Cursor="Hand"
                            Command="{Binding SignUpCommand}" Visibility="{Binding IsSignUpStep, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NmButtonPrimary}"/>

                    <Button x:Name="VerifyButton" Content="{Binding VerifyButtonContent}" Height="42" Cursor="Hand"
                            Command="{Binding VerifyCommand}" Visibility="{Binding IsVerificationStep, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource NmButtonPrimary}"/>

                    <!-- Navigation to Sign In -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                        <TextBlock Text="¿Ya tienes un perfil? " Style="{StaticResource NmBodyText}"/>
                        <TextBlock Text="Iniciar sesión" Style="{StaticResource NmBodyText}" Foreground="{DynamicResource NmAccentBrush}" FontWeight="SemiBold"
                                   Cursor="Hand" MouseLeftButtonDown="NavigateToLogin_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>