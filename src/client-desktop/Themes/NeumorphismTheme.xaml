<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================= -->
    <!-- NEUMORPHIC DARK THEME – DESIGN TOKENS (COLORS)                    -->
    <!-- ================================================================= -->
    <Color x:Key="NmBgBaseColor">#1E1E2E</Color>
    <Color x:Key="NmSurfaceColor">#1E1E2E</Color>
    <Color x:Key="NmShadowLightColor">#2A2A3E</Color>
    <Color x:Key="NmShadowDarkColor">#141420</Color>
    <Color x:Key="NmTextPrimaryColor">#E8E8F0</Color>
    <Color x:Key="NmTextSecondaryColor">#9090A8</Color>
    <Color x:Key="NmAccentColor">#1A47C8</Color>
    <Color x:Key="NmAccentHoverColor">#2E5CE6</Color>
    <Color x:Key="NmErrorColor">#FF7675</Color>
    <Color x:Key="NmSuccessColor">#55EFC4</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="NmBgBaseBrush" Color="{StaticResource NmBgBaseColor}" />
    <SolidColorBrush x:Key="NmSurfaceBrush" Color="{StaticResource NmSurfaceColor}" />
    <SolidColorBrush x:Key="NmShadowLightBrush" Color="{StaticResource NmShadowLightColor}" />
    <SolidColorBrush x:Key="NmShadowDarkBrush" Color="{StaticResource NmShadowDarkColor}" />
    <SolidColorBrush x:Key="NmTextPrimaryBrush" Color="{StaticResource NmTextPrimaryColor}" />
    <SolidColorBrush x:Key="NmTextSecondaryBrush" Color="{StaticResource NmTextSecondaryColor}" />
    <SolidColorBrush x:Key="NmAccentBrush" Color="{StaticResource NmAccentColor}" />
    <SolidColorBrush x:Key="NmAccentHoverBrush" Color="{StaticResource NmAccentHoverColor}" />
    <SolidColorBrush x:Key="NmErrorBrush" Color="{StaticResource NmErrorColor}" />
    <SolidColorBrush x:Key="NmSuccessBrush" Color="{StaticResource NmSuccessColor}" />

    <!-- Deprecated Resource Alias Compatibility -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource NmBgBaseColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource NmSurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource NmTextPrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource NmTextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentColor" Color="{StaticResource NmAccentColor}" />
    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource NmShadowDarkColor}" />
    <SolidColorBrush x:Key="ControlBackground" Color="{StaticResource NmSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorText" Color="{StaticResource NmErrorColor}" />
    <Color x:Key="AcrylicTintColor">#1E1E2E</Color>
    <system:Double x:Key="AcrylicTintOpacity">0.9</system:Double>

    <!-- ================================================================= -->
    <!-- TYPOGRAPHY                                                        -->
    <!-- ================================================================= -->
    <FontFamily x:Key="InterfaceFont">./Fonts/#Inter</FontFamily>
    <FontFamily x:Key="TechnicalFont">./Fonts/#Inter</FontFamily>

    <!-- ================================================================= -->
    <!-- TEXT STYLES                                                       -->
    <!-- ================================================================= -->
    <Style x:Key="NmDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
    </Style>

    <Style x:Key="NmTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
    </Style>

    <Style x:Key="NmBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource NmTextSecondaryBrush}" />
    </Style>

    <Style x:Key="NmLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource NmTextSecondaryBrush}" />
    </Style>

    <!-- Compatibility Typo Aliases -->
    <Style x:Key="CyberDisplayText" TargetType="TextBlock" BasedOn="{StaticResource NmDisplayText}" />
    <Style x:Key="CyberTitleText" TargetType="TextBlock" BasedOn="{StaticResource NmTitleText}" />
    <Style x:Key="CyberBodyText" TargetType="TextBlock" BasedOn="{StaticResource NmBodyText}" />
    <Style x:Key="CyberTechMonoText" TargetType="TextBlock" BasedOn="{StaticResource NmBodyText}" />
    <Style x:Key="CyberLabel" TargetType="TextBlock" BasedOn="{StaticResource NmLabelText}" />

    <!-- ================================================================= -->
    <!-- BORDERS & CARDS                                                   -->
    <!-- ================================================================= -->
    <Style x:Key="NmCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{StaticResource NmSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NmShadowDarkColor}" ShadowDepth="8" Direction="315" BlurRadius="18" Opacity="0.85"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compatibility Border Alias -->
    <Style x:Key="CyberPanelBorder" TargetType="Border" BasedOn="{StaticResource NmCardBorder}"/>

    <!-- Default Border style -->
    <Style TargetType="Border">
        <Setter Property="CornerRadius" Value="22"/>
    </Style>

    <!-- ================================================================= -->
    <!-- INPUT FIELD STYLES (INSET NEUMORPHIC)                             -->
    <!-- ================================================================= -->
    <Style x:Key="NmInputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource NmBgBaseBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NmTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource NmAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NmAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Top-left dark inset border shadow highlight -->
                        <Border CornerRadius="14" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0" IsHitTestVisible="False"/>
                        <!-- Bottom-right light inset border shadow highlight -->
                        <Border CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5" IsHitTestVisible="False"/>
                        <!-- Visual focus outline (extremely subtle accent line) -->
                        <Border x:Name="FocusBorder" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource NmAccentBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit TextBox picks up NmInputStyle -->
    <Style TargetType="TextBox" BasedOn="{StaticResource NmInputStyle}" />

    <!-- PasswordBox style mirroring NmInputStyle -->
    <Style x:Key="NmPasswordStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource NmBgBaseBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NmTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{StaticResource NmAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NmAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <!-- Top-left dark inset border shadow highlight -->
                        <Border CornerRadius="14" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0" IsHitTestVisible="False"/>
                        <!-- Bottom-right light inset border shadow highlight -->
                        <Border CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5" IsHitTestVisible="False"/>
                        <!-- Visual focus outline (extremely subtle accent line) -->
                        <Border x:Name="FocusBorder" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource NmAccentBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit PasswordBox picks up NmPasswordStyle -->
    <Style TargetType="PasswordBox" BasedOn="{StaticResource NmPasswordStyle}" />

    <!-- Compatibility aliases -->
    <Style x:Key="CyberTextBox" TargetType="TextBox" BasedOn="{StaticResource NmInputStyle}"/>
    <Style x:Key="CyberPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource NmPasswordStyle}"/>

    <!-- ================================================================= -->
    <!-- BUTTON STYLES                                                     -->
    <!-- ================================================================= -->

    <!-- Primary Button (Raised Neumorphic -> Pressed Sunken) -->
    <Style x:Key="NmButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NmAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="BtnGrid">
                        <!-- Raised Shadows (Normal state) -->
                        <Border x:Name="ShadowLight" CornerRadius="16" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="7" Direction="135" BlurRadius="14" Opacity="1.0"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ShadowDark" CornerRadius="16" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="7" Direction="315" BlurRadius="14" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>

                        <!-- Sunken Inset Shadows (Pressed state) -->
                        <Border x:Name="SunkenDark" CornerRadius="16" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0" Visibility="Collapsed"/>
                        <Border x:Name="SunkenLight" CornerRadius="16" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5" Visibility="Collapsed"/>

                        <!-- Actual Main Surface Button -->
                        <Border x:Name="MainBorder" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Solid soft accent color -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NmAccentHoverBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- Pressed: sunken state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ShadowLight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ShadowDark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SunkenDark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SunkenLight" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MainBorder" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnGrid" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button (Raised Neumorphic -> Hover Red -> Pressed Sunken) -->
    <Style x:Key="NmButtonDanger" TargetType="Button" BasedOn="{StaticResource NmButtonPrimary}">
        <Setter Property="Background" Value="{StaticResource NmErrorBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="BtnGrid">
                        <Border x:Name="ShadowLight" CornerRadius="16" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="7" Direction="135" BlurRadius="14" Opacity="1.0"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ShadowDark" CornerRadius="16" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="7" Direction="315" BlurRadius="14" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="SunkenDark" CornerRadius="16" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0" Visibility="Collapsed"/>
                        <Border x:Name="SunkenLight" CornerRadius="16" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5" Visibility="Collapsed"/>

                        <Border x:Name="MainBorder" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: solid soft red -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="#FF7675" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ShadowLight" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ShadowDark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SunkenDark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SunkenLight" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MainBorder" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource NmErrorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnGrid" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost/Secondary Button (Flat, text only with soft hover glow) -->
    <Style x:Key="NmButtonGhost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NmTextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#10FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource NmTextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit Button picks up NmButtonPrimary -->
    <Style TargetType="Button" BasedOn="{StaticResource NmButtonPrimary}" />

    <!-- Compatibility aliases -->
    <Style x:Key="CyberButton" TargetType="Button" BasedOn="{StaticResource NmButtonPrimary}"/>
    <Style x:Key="CyberIconButton" TargetType="Button" BasedOn="{StaticResource NmButtonGhost}"/>

    <!-- ================================================================= -->
    <!-- OVERRIDES FOR OTHER BASIC CONTROLS                                -->
    <!-- ================================================================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                        <BulletDecorator.Bullet>
                            <Grid Width="16" Height="16" Margin="0,0,6,0">
                                <!-- Sunken CheckBox border -->
                                <Border CornerRadius="4" Background="{DynamicResource NmBgBaseBrush}" BorderBrush="{DynamicResource NmShadowDarkBrush}" BorderThickness="1.5,1.5,0,0"/>
                                <Border CornerRadius="4" Background="Transparent" BorderBrush="{DynamicResource NmShadowLightBrush}" BorderThickness="0,0,1.5,1.5"/>
                                <!-- Check indicator (Accented circle/check) -->
                                <Border x:Name="CheckMark" Width="8" Height="8" CornerRadius="2" Background="{DynamicResource NmAccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource NmSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <!-- Raised Neumorphic Border -->
                        <Border x:Name="ShadowLight" Grid.ColumnSpan="2" CornerRadius="10" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowLightColor}" ShadowDepth="2" Direction="135" BlurRadius="4" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ShadowDark" Grid.ColumnSpan="2" CornerRadius="10" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="2" Direction="315" BlurRadius="4" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Border" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="0" />
                        
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        
                        <ToggleButton x:Name="ToggleButton" Grid.Column="1" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path x:Name="Arrow" Fill="{StaticResource NmTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0 Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource NmAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder" Background="{StaticResource NmBgBaseBrush}" BorderThickness="1" BorderBrush="{StaticResource NmShadowLightBrush}" CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource NmShadowDarkColor}" ShadowDepth="4" Direction="315" BlurRadius="8" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource NmBgBaseBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource NmBgBaseBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource NmShadowLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NmAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource NmAccentBrush}" />
                            <Setter Property="Foreground" Value="#1E1E2E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource NmShadowLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource NmShadowLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource NmAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NmTextSecondaryBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border" CornerRadius="6,6,0,0" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NmTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NmAccentBrush}" />
                            <Setter Property="Background" Value="{DynamicResource NmShadowLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Width="8" Height="8">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="{DynamicResource NmShadowLightBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Width="8" AutomationProperties.Name="Vertical ScrollBar" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Height="8" Orientation="Horizontal" AutomationProperties.Name="Horizontal ScrollBar" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource NmShadowLightBrush}" />
        <Setter Property="Height" Value="1"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>
</ResourceDictionary>
