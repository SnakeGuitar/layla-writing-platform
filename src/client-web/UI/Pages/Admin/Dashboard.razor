@page "/admin/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using client_web.Application.Services.Admin
@using client_web.Application.Services.Session
@inject IAdminService AdminService
@inject ISessionManager Session
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Dashboard> Logger

<PageTitle>Administracion</PageTitle>

<header class="max-w-5xl mx-auto mb-12">
    <h2 class="text-amber-500 text-xs font-bold tracking-[0.3em] uppercase mb-3">Administracion</h2>
    <h1 class="text-stone-100 font-serif text-4xl md:text-5xl font-light tracking-tight">
        Panel
    </h1>
    <div class="mt-4 w-16 h-px bg-amber-500"></div>
</header>

@if (!_sessionReady || _loading)
{
    <p class="text-stone-500 text-sm">Cargando panel...</p>
}
else if (!_isAuthorized)
{
    <p class="text-red-400 text-sm">No tienes permisos de administracion para ver este panel.</p>
}
else if (_error is not null)
{
    <p class="text-red-400 text-sm">@_error</p>
}
else if (_stats is not null)
{
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4 mb-8 max-w-5xl mx-auto">
        <StatCard Label="Usuarios totales" Value="@_stats.TotalUsers" />
        <StatCard Label="Nuevos este mes" Value="@_stats.NewUsersThisMonth" />
        <StatCard Label="Usuarios bloqueados" Value="@_stats.BannedUsers" />
        <StatCard Label="Proyectos totales" Value="@_stats.TotalProjects" />
        <StatCard Label="Modificados hoy" Value="@_stats.ProjectsModifiedToday" />
        <StatCard Label="Proyectos publicos" Value="@_stats.PublicProjects" />
    </div>

    <div class="max-w-5xl mx-auto bg-base-gray-2 rounded-lg p-6 shadow">
        <h3 class="text-stone-200 text-sm font-semibold tracking-wide uppercase mb-4">
            Usuarios nuevos - ultimos 12 meses
        </h3>
        <canvas id="adminUsersChart" width="800" height="280"></canvas>
    </div>
}

@code {
    private DashboardStats? _stats;
    private bool _loading = true;
    private bool _sessionReady;
    private bool _isAuthorized;
    private string? _error;
    private bool _chartRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.InitializeAsync();
            _sessionReady = true;

            if (!Session.IsAuthenticated)
            {
                Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/admin/dashboard")}");
                StateHasChanged();
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthorized = authState.User.IsInRole("Admin");
            if (_isAuthorized)
            {
                await LoadAsync();
            }
            else
            {
                _loading = false;
            }

            StateHasChanged();
        }

        if (_isAuthorized && _stats is not null && !_chartRendered)
        {
            try
            {
                await JS.InvokeVoidAsync("createBarChart", "adminUsersChart", _stats.NewUsersPerMonth);
                _chartRendered = true;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not render the dashboard chart.");
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _stats = await AdminService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard stats.");
            _error = "No se pudo cargar el panel de administracion.";
        }
        finally
        {
            _loading = false;
        }
    }
}
