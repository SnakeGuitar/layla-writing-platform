@page "/projects/explore"
@using client_web.Application.Services.Projects
@using client_web.Application.Services.Session
@using client_web.Models
@using client_web.UI.Components.Donations
@inject IProjectService ProjectService
@inject ISessionManager Session
@inject NavigationManager Navigation

<PageTitle>Explorar proyectos</PageTitle>

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <header class="mb-8 border-b border-[var(--nm-shadow-dark)] pb-4">
        <span class="nm-text-label">Biblioteca publica</span>
        <h1 class="nm-text-display mt-1 uppercase">
            Proyectos publicos
        </h1>
        <p class="nm-text-body text-xs mt-2 max-w-2xl">
            Descubre historias compartidas y unete como lector o colaborador.
        </p>
    </header>

    <!-- Search and Controls -->
    <div class="nm-card flex flex-col sm:flex-row gap-4 items-center justify-between p-4 bg-[var(--nm-surface)]">
        <div class="relative w-full sm:max-w-xs">
            <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Buscar por titulo, genero o sinopsis..."
                   id="search-explore-input"
                   class="nm-input w-full pr-10" />
            <span class="absolute right-3 top-2.5 text-[var(--nm-text-secondary)] font-mono text-xs">
                Buscar
            </span>
        </div>
        <div class="nm-text-label text-xs">
            @FilteredProjects.Count de @_publicProjects.Count proyectos
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="p-3 bg-[var(--nm-bg-base)] border border-[var(--nm-error)] text-[var(--nm-error)] text-xs font-mono">
            <span class="font-bold">Error:</span> @_error
        </div>
    }

    <!-- Projects Grid -->
    @if (_loading)
    {
        <div class="flex flex-col items-center justify-center py-16 space-y-2">
            <p class="nm-text-label text-sm text-[var(--nm-text-secondary)] animate-pulse">Cargando proyectos publicos...</p>
        </div>
    }
    else if (!FilteredProjects.Any())
    {
        <div class="nm-card text-center py-12">
            <p class="nm-text-label text-sm text-[var(--nm-text-secondary)]">No encontramos proyectos publicos.</p>
        </div>
    }
    else
    {
        <div class="grid md:grid-cols-2 gap-4">
            @foreach (var project in FilteredProjects)
            {
                <div class="nm-card p-4 flex flex-col justify-between hover:border-[var(--nm-accent)] hover:shadow-[0_0_8px_rgba(26,71,200,0.24)] transition-all duration-100 steps-2 group">
                    
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 bg-[var(--nm-surface)] border border-[var(--nm-shadow-light)] nm-text-label text-[10px]">
                                @project.LiteraryGenre
                            </span>
                            <span class="text-[10px] nm-text-label">
                                Actualizado: @project.UpdatedAt.ToString("yyyy-MM-dd")
                            </span>
                        </div>

                        <div>
                            <h3 class="nm-text-title uppercase truncate mt-1 group-hover:text-[var(--nm-accent)] transition-colors duration-100">
                                @project.Title
                            </h3>
                            <p class="nm-text-body text-xs mt-1 line-clamp-3">
                                @project.Synopsis
                            </p>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-[var(--nm-shadow-dark)] flex items-center justify-between">
                        <span class="nm-text-label text-[10px]">@(IsMember(project.Id) ? "En tu biblioteca" : "Publico")</span>
                        
                        <div class="flex items-center gap-2">
                            <button @onclick="() => OpenDonationModal(project)"
                                    class="nm-button-ghost text-xs py-1 px-3">
                                Donar
                            </button>
                            <button @onclick="() => HandleProjectActionAsync(project.Id)"
                                    disabled="@_joining"
                                    id="join-btn-@project.Id"
                                    class="nm-button text-xs py-1 px-3">
                                @if (_joining && _activeJoiningId == project.Id)
                                {
                                    <span>Uniendo...</span>
                                }
                                else if (IsMember(project.Id))
                                {
                                    <span>Abrir</span>
                                }
                                else
                                {
                                    <span>Unirme</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<PayPalDonationModal IsOpen="@_donationModalOpen"
                     IsOpenChanged="@(value => _donationModalOpen = value)"
                     ProjectId="@_donationProjectId"
                     ProjectTitle="@_donationProjectTitle" />

@code {
    private List<PublicProjectDto> _publicProjects = new();
    private List<Project> _myProjects = new();
    private bool _loading = true;
    private bool _joining = false;
    private Guid? _activeJoiningId;
    private string _searchQuery = string.Empty;
    private string? _error;
    private bool _donationModalOpen;
    private Guid _donationProjectId;
    private string _donationProjectTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var hadToken = Session.IsAuthenticated;
        var restored = await Session.InitializeAsync();
        if (restored && !hadToken)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var publicResult = await ProjectService.GetPublicProjectsAsync();
            
            if (Session.IsAuthenticated)
            {
                var myResult = await ProjectService.GetMyProjectsAsync();
                _myProjects = myResult.ToList();
            }

            _publicProjects = publicResult.ToList();
        }
        catch (Exception)
        {
            _error = "Error al conectar con el servidor.";
        }
        finally
        {
            _loading = false;
        }
    }

    private List<PublicProjectDto> FilteredProjects =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? _publicProjects
            : _publicProjects.Where(p =>
                p.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.Synopsis.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.LiteraryGenre.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool IsMember(Guid projectId) => _myProjects.Any(project => project.Id == projectId);

    private async Task HandleProjectActionAsync(Guid projectId)
    {
        if (IsMember(projectId))
        {
            Navigation.NavigateTo($"/projects/{projectId}");
            return;
        }

        await JoinProjectAsync(projectId);
    }

    private async Task JoinProjectAsync(Guid projectId)
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        _joining = true;
        _activeJoiningId = projectId;
        _error = null;
        StateHasChanged();

        try
        {
            var success = await ProjectService.JoinPublicProjectAsync(projectId);
            if (success)
            {
                // Navigate directly to the newly joined project's workspace!
                Navigation.NavigateTo($"/projects/{projectId}");
            }
            else
            {
                _error = "No se pudo unir al proyecto. Por favor, inténtelo de nuevo.";
            }
        }
        catch (Exception)
        {
            _error = "Ocurrió un error inesperado al intentar unirse al proyecto.";
        }
        finally
        {
            _joining = false;
            _activeJoiningId = null;
            StateHasChanged();
        }
    }

    private void OpenDonationModal(PublicProjectDto project)
    {
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/projects/explore")}");
            return;
        }

        _donationProjectId = project.Id;
        _donationProjectTitle = project.Title;
        _donationModalOpen = true;
    }
}
