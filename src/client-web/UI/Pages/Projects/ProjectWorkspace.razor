@page "/projects/{ProjectId:guid}"
@using client_web.Application.Services.Projects
@using client_web.Application.Services.Session
@using client_web.Models
@using client_web.UI.Components.Workspace
@inject IProjectService ProjectService
@inject ISessionManager Session
@inject NavigationManager Navigation

<PageTitle>@(_project?.Title ?? "Proyecto") - Layla</PageTitle>

<div class="max-w-7xl mx-auto space-y-4">
    @if (!_sessionReady || _loading)
    {
        <div class="flex items-center justify-center py-16">
            <p class="nm-text-label text-sm text-[var(--nm-text-secondary)] animate-pulse">Abriendo el proyecto...</p>
        </div>
    }
    else if (_project == null)
    {
        <div class="nm-card p-6 max-w-lg mx-auto text-center mt-12 border-[var(--nm-error)] bg-[var(--nm-bg-base)]">
            <h3 class="nm-text-title text-[var(--nm-error)] mb-2 uppercase">No se pudo abrir</h3>
            <p class="nm-text-body text-xs mb-4">@(_error ?? "El proyecto solicitado no existe o tu rol no permite leerlo.")</p>
            <a href="/projects/my-projects" class="nm-button text-xs inline-flex">
                Volver a proyectos
            </a>
        </div>
    }
    else
    {
        <!-- Header -->
        <header class="nm-card p-4 bg-[var(--nm-surface)]">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="nm-text-label">Espacio de escritura</span>
                        <span class="px-2 py-0.5 bg-[var(--nm-bg-base)] border border-[var(--nm-shadow-dark)] nm-text-label text-[10px]">
                            @_project.LiteraryGenre
                        </span>
                        @if (!string.IsNullOrEmpty(_project.UserRole))
                        {
                            <span class="px-2 py-0.5 bg-[var(--nm-bg-base)] border border-[var(--nm-accent)] text-[var(--nm-accent)] nm-text-label text-[10px]">
                                @_project.UserRole.ToUpper()
                            </span>
                        }
                    </div>
                    <h1 class="nm-text-display uppercase mt-1">
                        @_project.Title
                    </h1>
                    <p class="nm-text-body text-xs max-w-3xl">
                        @_project.Synopsis
                    </p>
                </div>
                <div class="shrink-0 flex gap-2 items-center">
                    @if (_project.UserRole == "OWNER")
                    {
                        <button @onclick="ToggleCollaboratorsModal"
                                class="nm-button text-xs py-1 px-3">
                            Colaboradores
                        </button>
                    }
                    <button @onclick="ToggleVoiceDrawer"
                            id="voice-toggle-btn"
                            class="nm-button text-xs py-1 px-3">
                        Voz
                    </button>
                    <a href="/projects/my-projects" class="nm-button text-xs py-1 px-3">
                        Volver
                    </a>
                </div>
            </div>
        </header>

        <!-- Navigation Tabs -->
        <div class="border-b border-[var(--nm-shadow-dark)] pb-px">
            <nav class="flex gap-4" aria-label="Tabs">
                @foreach (var tab in _tabs)
                {
                    var isSelected = _activeTab == tab.Id;
                    <button @onclick="() => SetActiveTab(tab.Id)"
                            class="pb-2 text-xs font-mono uppercase tracking-wider relative transition-all duration-100 outline-none
                                   @(isSelected ? "text-[var(--nm-accent)]" : "text-[var(--nm-text-secondary)] hover:text-[var(--nm-text-primary)]")">
                        @tab.Label
                        @if (isSelected)
                        {
                            <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-[var(--nm-accent)]"></div>
                        }
                    </button>
                }
            </nav>
        </div>

        <!-- Dynamic Content -->
        <div class="transition-opacity duration-100">
            @if (_activeTab == "manuscript")
            {
                <ManuscriptTab ProjectId="ProjectId" IsReadOnly="IsReadOnly" />
            }
            else if (_activeTab == "wiki")
            {
                <WikiTab ProjectId="ProjectId" IsReadOnly="IsReadOnly" />
            }
            else if (_activeTab == "graph")
            {
                <GraphTab ProjectId="ProjectId" IsReadOnly="IsReadOnly" />
            }
        </div>

        <VoiceDrawer ProjectId="ProjectId" IsReadOnly="IsReadOnly" @bind-IsOpen="_voiceDrawerOpen" />
        <CollaboratorsModal ProjectId="ProjectId" @bind-IsOpen="_collaboratorsModalOpen" />
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Project? _project;
    private bool _loading = true;
    private bool _sessionReady;
    private string? _error;
    private string _activeTab = "manuscript";
    private bool _voiceDrawerOpen = false;
    private bool _collaboratorsModalOpen = false;

    private bool IsReadOnly => string.Equals(_project?.UserRole, "READER", StringComparison.OrdinalIgnoreCase);

    private void ToggleVoiceDrawer()
    {
        _voiceDrawerOpen = !_voiceDrawerOpen;
    }

    private void ToggleCollaboratorsModal()
    {
        _collaboratorsModalOpen = !_collaboratorsModalOpen;
    }

    private readonly List<(string Id, string Label)> _tabs = new()
    {
        ("manuscript", "Manuscritos"),
        ("wiki", "Wiki"),
        ("graph", "Grafo narrativo")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await EnsureSessionAsync();
        _sessionReady = true;
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString($"/projects/{ProjectId}")}");
            StateHasChanged();
            return;
        }

        await LoadProjectAsync();
        StateHasChanged();
    }

    private async Task LoadProjectAsync()
    {
        _loading = true;
        try
        {
            if (!Session.IsAuthenticated)
            {
                _project = null;
                return;
            }
            _project = await ProjectService.GetProjectByIdAsync(ProjectId);
            _error = _project is null
                ? "No encontramos este proyecto o tu rol no permite acceder."
                : null;
        }
        catch (Exception)
        {
            _project = null;
            _error = "No se pudo abrir el workspace. Revisa la conexión con el servidor.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetActiveTab(string tabId)
    {
        _activeTab = tabId;
    }

    private async Task EnsureSessionAsync()
    {
        for (var attempt = 0; attempt < 3 && !Session.IsAuthenticated; attempt++)
        {
            await Session.InitializeAsync();
            if (!Session.IsAuthenticated)
                await Task.Delay(100);
        }
    }
}
