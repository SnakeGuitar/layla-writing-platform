@using System.Threading
@using client_web.Application.Services.Manuscripts
@using client_web.Application.Services.Session
@using client_web.Application.Services.Wikis
@using client_web.Models.Worldbuilding
@using Layla.Client.Shared.Hub
@using Layla.Client.Shared.Models
@using Layla.Client.Shared.Tokenizer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

@inject IManuscriptService ManuscriptService
@inject IWikiService WikiService
@inject ISessionManager Session
@inject ManuscriptHubClient HubClient
@inject IConfiguration Configuration

<div class="grid grid-cols-1 xl:grid-cols-[320px_minmax(0,1fr)_360px] 2xl:grid-cols-[340px_minmax(0,1fr)_420px] gap-4 h-[760px]">
    <div class="p-4 bg-[var(--nm-surface)] border border-[var(--nm-shadow-dark)] flex flex-col h-full overflow-hidden">
        <div class="flex items-center justify-between border-b border-[var(--nm-shadow-dark)] pb-2 mb-3 shrink-0">
            <h3 class="nm-text-label text-xs text-[var(--nm-text-secondary)] uppercase">Manuscritos</h3>
            @if (!IsReadOnly)
            {
                <button @onclick="ToggleAddManuscriptForm" class="nm-button text-[10px] py-0.5 px-2">
                    Nuevo
                </button>
            }
        </div>

        @if (_showAddMsForm && !IsReadOnly)
        {
            <div class="p-3 bg-[var(--nm-bg-base)] border border-[var(--nm-shadow-dark)] mb-3 shrink-0 space-y-2">
                <input @bind="_newMsTitle" placeholder="Título del manuscrito" class="nm-input text-xs w-full" />
                <div class="flex justify-end gap-2 text-xs">
                    <button @onclick="ToggleAddManuscriptForm" class="nm-button-ghost text-[10px]">Cancelar</button>
                    <button @onclick="CreateManuscriptAsync" class="nm-button text-[10px] py-0.5 px-2">Crear</button>
                </div>
            </div>
        }

        <div class="flex-1 overflow-y-auto pr-1 space-y-2 text-sm text-[var(--nm-text-secondary)]">
            @if (_loading)
            {
                <p class="nm-text-label text-xs text-[var(--nm-text-secondary)] animate-pulse">Cargando manuscritos...</p>
            }
            else if (_manuscripts == null || _manuscripts.Count == 0)
            {
                <p class="nm-text-label text-xs text-[var(--nm-text-secondary)] py-4 text-center">No hay manuscritos.</p>
            }
            else
            {
                @foreach (var ms in _manuscripts)
                {
                    var isExpanded = _expandedMs.Contains(ms.ManuscriptId);
                    <div class="border border-[var(--nm-shadow-dark)] bg-[var(--nm-bg-base)] p-2 space-y-1">
                        <div class="flex items-center justify-between group">
                            <div class="flex items-center gap-2 cursor-pointer flex-1" @onclick="() => ToggleMsExpansion(ms.ManuscriptId)">
                                <span class="text-[var(--nm-text-secondary)] text-xs select-none">@(isExpanded ? "▼" : "▶")</span>
                                <span class="font-mono text-xs uppercase text-[var(--nm-text-primary)] truncate">@ms.Title</span>
                            </div>
                            @if (!IsReadOnly)
                            {
                                <div class="opacity-0 group-hover:opacity-100 flex gap-2 transition-all duration-100">
                                    <button @onclick="() => ShowAddChapterForm(ms.ManuscriptId)" title="Añadir capítulo" class="text-[10px] text-[var(--nm-accent)] hover:underline">Capítulo</button>
                                    <button @onclick="() => DeleteManuscriptAsync(ms.ManuscriptId)" title="Eliminar manuscrito" class="text-[10px] text-[var(--nm-error)] hover:underline">Eliminar</button>
                                </div>
                            }
                        </div>

                        @if (isExpanded)
                        {
                            <div class="pl-3 border-l border-[var(--nm-shadow-dark)] mt-1 space-y-1">
                                @if (_addingChapterMsId == ms.ManuscriptId && !IsReadOnly)
                                {
                                    <div class="p-2 bg-[var(--nm-surface)] border border-[var(--nm-shadow-dark)] space-y-2 mt-1">
                                        <input @bind="_newChapTitle" placeholder="Título del capítulo" class="nm-input text-xs w-full" />
                                        <div class="flex justify-end gap-1.5 text-[10px]">
                                            <button @onclick="CancelAddChapter" class="nm-button-ghost text-[10px]">Cancelar</button>
                                            <button @onclick="() => CreateChapterAsync(ms.ManuscriptId)" class="nm-button text-[10px] py-0.5 px-2">Crear</button>
                                        </div>
                                    </div>
                                }

                                @foreach (var chap in ms.Chapters ?? new List<Chapter>())
                                {
                                    var isSelected = _selectedChapter?.ChapterId == chap.ChapterId;
                                    <div class="flex items-center justify-between group/chap p-1 hover:bg-[var(--nm-surface)] cursor-pointer @(isSelected ? "bg-[rgba(26,71,200,0.18)] border-l-2 border-[var(--nm-accent)] pl-1.5" : "")"
                                         @onclick="() => SelectChapterAsync(chap, ms.ManuscriptId)">
                                        <span class="truncate flex-1 text-xs @(isSelected ? "text-[var(--nm-accent)] font-mono" : "text-[var(--nm-text-secondary)]")">@chap.Title</span>
                                        @if (!IsReadOnly)
                                        {
                                            <button @onclick="() => DeleteChapterAsync(ms.ManuscriptId, chap.ChapterId)" @onclick:stopPropagation="true"
                                                    class="opacity-0 group-hover/chap:opacity-100 text-[10px] text-[var(--nm-error)] hover:underline">
                                                X
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="p-4 bg-[var(--nm-surface)] border border-[var(--nm-shadow-dark)] flex flex-col h-full min-w-0">
        @if (IsReadOnly)
        {
            <div class="flex items-center justify-between border-b border-[var(--nm-shadow-dark)] pb-3 mb-3 shrink-0 gap-3">
                <div>
                    <span class="nm-text-label text-xs text-[var(--nm-text-secondary)] uppercase">Lectura completa</span>
                    <h3 class="nm-text-title text-[var(--nm-text-primary)] uppercase">Historia</h3>
                </div>
                <span class="text-[10px] font-mono uppercase text-[var(--nm-accent)]">Solo lectura</span>
            </div>

            <div class="flex-1 overflow-y-auto pr-3 space-y-8">
                @if (_manuscripts == null || _manuscripts.Count == 0)
                {
                    <div class="h-full flex flex-col items-center justify-center text-center">
                        <span class="nm-text-label text-xs text-[var(--nm-text-secondary)] mb-2">Sin manuscritos</span>
                        <p class="nm-text-body text-xs max-w-sm">Este proyecto aun no tiene historia publicada para lectura.</p>
                    </div>
                }
                else
                {
                    @foreach (var manuscript in _manuscripts.OrderBy(m => m.Order))
                    {
                        <article class="space-y-4">
                            <h2 class="nm-text-title text-[var(--nm-accent)] uppercase border-b border-[var(--nm-shadow-dark)] pb-2">
                                @manuscript.Title
                            </h2>

                            @foreach (var chapter in manuscript.Chapters.OrderBy(c => c.Order))
                            {
                                <section class="space-y-3">
                                    <h3 class="text-sm font-mono uppercase text-[var(--nm-text-primary)]">
                                        @chapter.Title
                                    </h3>
                                    <div class="nm-text-body text-sm leading-7 text-[var(--nm-text-primary)] bg-[var(--nm-bg-base)] border border-[var(--nm-shadow-dark)] p-4 overflow-x-auto">
                                        @if (string.IsNullOrWhiteSpace(chapter.Content))
                                        {
                                            <span class="text-[var(--nm-text-secondary)] italic">Capitulo vacio.</span>
                                        }
                                        else
                                        {
                                            @((MarkupString)chapter.Content)
                                        }
                                    </div>
                                </section>
                            }
                        </article>
                    }
                }
            </div>
        }
        else if (_selectedChapter == null)
        {
            <div class="flex-1 flex flex-col items-center justify-center text-center">
                <span class="nm-text-label text-xs text-[var(--nm-text-secondary)] mb-2">Sin selección</span>
                <h3 class="nm-text-title text-[var(--nm-text-secondary)] uppercase mb-2">Elige un capítulo</h3>
                <p class="nm-text-body text-xs max-w-sm">Selecciona un capítulo o crea uno nuevo para empezar a escribir.</p>
            </div>
        }
        else
        {
            <div class="flex items-center justify-between border-b border-[var(--nm-shadow-dark)] pb-3 mb-3 shrink-0 gap-3">
                <div class="flex-1 max-w-lg">
                    <input @bind="_selectedChapter.Title" @oninput="TriggerAutoSave" disabled="@IsReadOnly"
                           class="w-full bg-[var(--nm-bg-base)] nm-text-title uppercase border border-[var(--nm-shadow-dark)] focus:border-[var(--nm-accent)] focus:outline-none px-3 py-1.5 disabled:opacity-70"
                           placeholder="Capítulo sin título" />
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <span class="text-[10px] font-mono uppercase @SaveStatusClass">@_saveStatus</span>
                    @if (!IsReadOnly)
                    {
                        <button @onclick="SaveNowAsync" class="nm-button text-xs py-1 px-3">Guardar</button>
                        <button @onclick="CreateMilestoneAsync" class="nm-button text-xs py-1 px-3">Crear hito</button>
                    }
                    <button @onclick="OpenVersionHistory" class="nm-button text-xs py-1 px-3">Historial</button>
                </div>
            </div>

            <div class="flex-1 overflow-hidden relative min-h-0">
                <RichTextEditor @ref="_editor"
                                @bind-Value="_selectedChapter.Content"
                                ReadOnly="IsReadOnly"
                                PlainTextChanged="OnPlainTextChanged"
                                CursorChanged="BroadcastCursorAsync" />
            </div>

            <div class="pt-2 flex items-center justify-between text-[10px] font-mono text-[var(--nm-text-secondary)] uppercase">
                <span>@_wordCount palabras</span>
                <span>@(_hubState == HubConnectionState.Connected ? "Colaboración activa" : "Colaboración desconectada")</span>
            </div>
        }
    </div>

    <aside class="p-4 bg-[var(--nm-surface)] border border-[var(--nm-shadow-dark)] flex flex-col h-full overflow-hidden">
        <div class="border-b border-[var(--nm-shadow-dark)] pb-2 mb-3">
            <h3 class="nm-text-label text-xs text-[var(--nm-text-secondary)] uppercase">Entidades del capítulo</h3>
        </div>

        @if (_currentMentions.Count == 0)
        {
            <p class="nm-text-body text-xs text-[var(--nm-text-secondary)]">Aún no se detectan entidades de la wiki en este capítulo.</p>
        }
        else
        {
            <div class="space-y-2 overflow-y-auto">
                @foreach (var mention in _currentMentions)
                {
                    <div class="p-2 bg-[var(--nm-bg-base)] border border-[var(--nm-shadow-dark)]">
                        <div class="text-xs text-[var(--nm-text-primary)] font-mono uppercase truncate">@mention.Name</div>
                        <div class="text-[10px] text-[var(--nm-accent)] uppercase">@mention.EntityType</div>
                    </div>
                }
            </div>
        }
    </aside>
</div>

@if (_selectedChapter != null)
{
    <VersionHistoryModal ProjectId="ProjectId"
                         ManuscriptId="@_activeManuscriptId"
                         ChapterId="@_selectedChapter.ChapterId"
                         CurrentContent="@_selectedChapter.Content"
                         IsReadOnly="IsReadOnly"
                         @bind-IsOpen="_versionHistoryOpen"
                         OnVersionRestored="HandleVersionRestored" />
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }

    private List<Manuscript>? _manuscripts;
    private bool _loading = true;
    private readonly HashSet<string> _expandedMs = new();
    private bool _showAddMsForm;
    private string _newMsTitle = string.Empty;
    private string _addingChapterMsId = string.Empty;
    private string _newChapTitle = string.Empty;
    private Chapter? _selectedChapter;
    private string _activeManuscriptId = string.Empty;
    private string _saveStatus = "Guardado";
    private CancellationTokenSource? _saveCts;
    private bool _versionHistoryOpen;
    private RichTextEditor? _editor;
    private readonly WikiTokenizer _tokenizer = new();
    private readonly List<Mention> _currentMentions = new();
    private bool _suppressEditorBroadcast;
    private bool _hubConnected;
    private HubConnectionState _hubState = HubConnectionState.Disconnected;
    private int _wordCount;

    private string SaveStatusClass => _saveStatus switch
    {
        "Guardando..." => "text-[var(--nm-error)] animate-pulse",
        "Error al guardar" => "text-[var(--nm-error)]",
        _ => "text-[var(--nm-accent)]"
    };

    protected override async Task OnInitializedAsync()
    {
        WireHubEvents();
        await LoadManuscriptsAsync();
        await RebuildTokenizerAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Session.InitializeAsync();
        await ConnectHubAsync();
    }

    private void WireHubEvents()
    {
        HubClient.TextChanged += async (_, content) =>
        {
            if (_selectedChapter == null || _editor == null) return;
            _suppressEditorBroadcast = true;
            _selectedChapter.Content = content;
            await InvokeAsync(async () =>
            {
                await _editor.SetContentAsync(content);
                StateHasChanged();
            });
            _suppressEditorBroadcast = false;
        };
        HubClient.ChapterSaved += async (projectId, chapterId) =>
        {
            if (projectId != ProjectId
                || _selectedChapter == null
                || _activeManuscriptId.Length == 0
                || chapterId != _selectedChapter.ChapterId.ToString())
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                var fresh = await ManuscriptService.GetChapterAsync(ProjectId, _activeManuscriptId, _selectedChapter.ChapterId);
                if (fresh == null || _editor == null) return;

                _suppressEditorBroadcast = true;
                _selectedChapter = fresh;
                _currentMentions.Clear();
                _currentMentions.AddRange(fresh.Mentions ?? new List<Mention>());
                await _editor.SetContentAsync(fresh.Content);
                CountWords(await _editor.GetPlainTextAsync());
                _saveStatus = "Actualizado";
                _suppressEditorBroadcast = false;
                StateHasChanged();
            });
        };
        HubClient.CursorMoved += async (userId, displayName, offset) =>
        {
            if (_editor != null)
                await InvokeAsync(() => _editor.ShowRemoteCursorAsync(userId, displayName, offset));
        };
        HubClient.CursorRemoved += async userId =>
        {
            if (_editor != null)
                await InvokeAsync(() => _editor.RemoveRemoteCursorAsync(userId));
        };
        HubClient.WikiEntitiesChanged += async () => await RebuildTokenizerAsync();
        HubClient.MilestoneCreated += async (projectId, chapterId) =>
        {
            if (projectId == ProjectId && _selectedChapter?.ChapterId.ToString() == chapterId)
                await InvokeAsync(StateHasChanged);
        };
        HubClient.ConnectionStateChanged += async state =>
        {
            _hubState = state;
            if (state == HubConnectionState.Connected && _selectedChapter != null)
                await JoinCurrentChapterAsync();
            await InvokeAsync(StateHasChanged);
        };
    }

    private async Task ConnectHubAsync()
    {
        if (_hubConnected || !Session.IsAuthenticated) return;

        var baseUrl = Configuration["ApiUrls:BackendURL"]?.TrimEnd('/') ?? "http://localhost:5000";
        await HubClient.ConnectAsync($"{baseUrl}/hubs/manuscript", () => Task.FromResult<string?>(Session.CurrentToken));
        _hubConnected = true;
        _hubState = HubClient.State;
        await JoinCurrentChapterAsync();
    }

    private async Task LoadManuscriptsAsync()
    {
        _loading = true;
        try
        {
            var list = IsReadOnly
                ? await ManuscriptService.GetFullStoryAsync(ProjectId)
                : await ManuscriptService.GetManuscriptsByProjectAsync(ProjectId);
            _manuscripts = list ?? new List<Manuscript>();
            if (_manuscripts.Count > 0)
            {
                _expandedMs.Add(_manuscripts[0].ManuscriptId);
                var firstChapter = _manuscripts[0].Chapters?.OrderBy(c => c.Order).FirstOrDefault();
                if (firstChapter != null && !IsReadOnly)
                    await SelectChapterAsync(firstChapter, _manuscripts[0].ManuscriptId);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RebuildTokenizerAsync()
    {
        var entities = await WikiService.GetDetectableEntitiesAsync(ProjectId);
        if (entities is { Count: > 0 })
            _tokenizer.Build(entities);
    }

    private void ToggleMsExpansion(string msId)
    {
        if (!_expandedMs.Add(msId))
            _expandedMs.Remove(msId);
    }

    private void ToggleAddManuscriptForm()
    {
        _showAddMsForm = !_showAddMsForm;
        _newMsTitle = string.Empty;
    }

    private async Task CreateManuscriptAsync()
    {
        if (IsReadOnly || string.IsNullOrWhiteSpace(_newMsTitle)) return;
        var order = _manuscripts?.Count ?? 0;
        var created = await ManuscriptService.CreateManuscriptAsync(ProjectId, _newMsTitle, order);
        if (created != null)
        {
            _expandedMs.Add(created.ManuscriptId);
            await LoadManuscriptsAsync();
            ToggleAddManuscriptForm();
        }
    }

    private async Task DeleteManuscriptAsync(string msId)
    {
        if (IsReadOnly) return;
        var success = await ManuscriptService.DeleteManuscriptAsync(ProjectId, msId);
        if (success)
        {
            if (_activeManuscriptId == msId)
                _selectedChapter = null;
            await LoadManuscriptsAsync();
        }
    }

    private void ShowAddChapterForm(string msId)
    {
        _addingChapterMsId = msId;
        _newChapTitle = string.Empty;
        _expandedMs.Add(msId);
    }

    private void CancelAddChapter()
    {
        _addingChapterMsId = string.Empty;
        _newChapTitle = string.Empty;
    }

    private async Task CreateChapterAsync(string msId)
    {
        if (IsReadOnly || string.IsNullOrWhiteSpace(_newChapTitle)) return;
        var targetMs = _manuscripts?.Find(m => m.ManuscriptId == msId);
        var order = targetMs?.Chapters?.Count ?? 0;
        var created = await ManuscriptService.CreateChapterAsync(ProjectId, msId, _newChapTitle, "<p>Empieza a escribir...</p>", order);
        if (created != null)
        {
            await LoadManuscriptsAsync();
            CancelAddChapter();
            await SelectChapterAsync(created, msId);
        }
    }

    private async Task DeleteChapterAsync(string msId, Guid chapterId)
    {
        if (IsReadOnly) return;
        var success = await ManuscriptService.DeleteChapterAsync(ProjectId, msId, chapterId);
        if (success)
        {
            if (_selectedChapter?.ChapterId == chapterId)
                _selectedChapter = null;
            await LoadManuscriptsAsync();
        }
    }

    private async Task SelectChapterAsync(Chapter chap, string msId)
    {
        await SaveNowAsync();
        await LeaveCurrentChapterAsync();

        var full = await ManuscriptService.GetChapterAsync(ProjectId, msId, chap.ChapterId);
        _selectedChapter = full ?? chap;
        _activeManuscriptId = msId;
        _saveStatus = "Guardado";
        _currentMentions.Clear();
        _currentMentions.AddRange(_selectedChapter.Mentions ?? new List<Mention>());
        CountWords(await GetPlainTextSafeAsync());

        await JoinCurrentChapterAsync();
        if (_editor != null)
            await _editor.SetContentAsync(_selectedChapter.Content);
    }

    private async Task JoinCurrentChapterAsync()
    {
        if (_hubState != HubConnectionState.Connected || _selectedChapter == null) return;
        try { await HubClient.JoinChapterGroupAsync(ProjectId, _selectedChapter.ChapterId.ToString()); }
        catch { }
    }

    private async Task LeaveCurrentChapterAsync()
    {
        if (_hubState != HubConnectionState.Connected || _selectedChapter == null) return;
        try { await HubClient.LeaveChapterGroupAsync(ProjectId, _selectedChapter.ChapterId.ToString()); }
        catch { }
    }

    private async Task OnPlainTextChanged(string plainText)
    {
        CountWords(plainText);
        UpdateMentions(plainText);
        if (!_suppressEditorBroadcast)
        {
            await BroadcastCurrentTextAsync();
            TriggerAutoSave();
        }
    }

    private void CountWords(string plainText)
    {
        _wordCount = string.IsNullOrWhiteSpace(plainText)
            ? 0
            : plainText.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private void UpdateMentions(string plainText)
    {
        var matches = _tokenizer.FindMentions(plainText);
        _currentMentions.Clear();
        _currentMentions.AddRange(matches.Select(m => new Mention
        {
            EntityId = m.EntityId,
            EntityType = m.EntityType,
            Name = m.MatchedText
        }));
    }

    private async Task BroadcastCurrentTextAsync()
    {
        if (IsReadOnly || _selectedChapter == null || _editor == null || _hubState != HubConnectionState.Connected) return;
        var html = await _editor.GetHtmlAsync();
        await HubClient.SendTextChangedAsync(ProjectId, _selectedChapter.ChapterId.ToString(), html);
    }

    private async Task BroadcastCursorAsync(int offset)
    {
        if (IsReadOnly || _selectedChapter == null || _hubState != HubConnectionState.Connected) return;
        await HubClient.SendCursorMovedAsync(ProjectId, _selectedChapter.ChapterId.ToString(), offset);
    }

    private void TriggerAutoSave(ChangeEventArgs? args = null)
    {
        if (IsReadOnly || _selectedChapter == null) return;
        _saveStatus = "Guardando...";
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(900, token);
                if (!token.IsCancellationRequested)
                    await InvokeAsync(() => SaveNowAsync(false));
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private async Task SaveNowAsync() => await SaveNowAsync(true);

    private async Task SaveNowAsync(bool force)
    {
        if (IsReadOnly || _selectedChapter == null || string.IsNullOrEmpty(_activeManuscriptId)) return;
        if (!force && _saveStatus != "Guardando...") return;

        _saveCts?.Cancel();
        var html = _editor == null ? _selectedChapter.Content : await _editor.GetHtmlAsync();
        var ok = await ManuscriptService.AutosaveChapterAsync(ProjectId, _activeManuscriptId, _selectedChapter.ChapterId, html, _currentMentions);
        _selectedChapter.Content = html;
        _selectedChapter.Mentions = _currentMentions.ToList();
        _saveStatus = ok ? "Guardado" : "Error al guardar";
        if (ok && _hubState == HubConnectionState.Connected)
            await HubClient.NotifyChapterSavedAsync(ProjectId, _selectedChapter.ChapterId.ToString());
        StateHasChanged();
    }

    private async Task CreateMilestoneAsync()
    {
        if (IsReadOnly || _selectedChapter == null || _editor == null) return;
        var html = await _editor.GetHtmlAsync();
        var ok = await ManuscriptService.AutosaveChapterAsync(ProjectId, _activeManuscriptId, _selectedChapter.ChapterId, html, _currentMentions, isMilestone: true);
        _saveStatus = ok ? "Hito creado" : "Error al crear hito";
        if (ok && _hubState == HubConnectionState.Connected)
            await HubClient.NotifyMilestoneCreatedAsync(ProjectId, _selectedChapter.ChapterId.ToString());
    }

    private void OpenVersionHistory()
    {
        _versionHistoryOpen = true;
    }

    private async Task HandleVersionRestored(string restoredContent)
    {
        if (_selectedChapter == null) return;
        _selectedChapter.Content = restoredContent;
        if (_editor != null)
            await _editor.SetContentAsync(restoredContent);
        TriggerAutoSave();
    }

    private async Task<string> GetPlainTextSafeAsync()
    {
        return _editor == null ? string.Empty : await _editor.GetPlainTextAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _saveCts?.Cancel();
        await SaveNowAsync();
        await LeaveCurrentChapterAsync();
        await HubClient.DisconnectAsync();
    }
}
