@* Monolithic technical metric widget *@
<div class="nm-card flex flex-col gap-1.5">
    <span class="nm-text-label">@Label</span>
    <span class="nm-text-display tabular-nums">@Value</span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int Value { get; set; }
}
